<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Đăng nhập - Book Club CTUT</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="{{ asset('assets/img/logo-ct-dark-mn76con.png') }}">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('assets/styles/app.css') }}">
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-gradient-to-br from-indigo-500 to-purple-600 min-h-screen flex items-center justify-center p-4 relative overflow-hidden">

    <!-- Background Pattern -->
    <div class="absolute inset-0 bg-[url('{{ asset('assets/img/bg-iN96iui.png') }}')] bg-cover opacity-10 z-0"></div>

    <div class="relative z-10 w-full max-w-md">
        <div class="bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl overflow-hidden">
            
            <!-- Top border gradient -->
            <div class="h-1.5 w-full bg-gradient-to-r from-indigo-400 to-purple-500"></div>
            
            <div class="p-8 text-center bg-gradient-to-b from-indigo-50/50 to-transparent">
                <img src="{{ asset('assets/img/logo-ct-dark-mn76con.png') }}" alt="Logo" class="w-24 h-auto mx-auto mb-6 drop-shadow-sm">
                <h4 class="text-2xl font-bold text-slate-800 mb-1">Book Club CTUT</h4>
                <p class="text-slate-500 text-sm">Hệ thống quản lý CLB SV Yêu Thích Sách</p>
            </div>
            
            <div class="px-8 pb-8">
                {% for message in app.flashes('success') %}
                    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 flex items-center text-sm">
                        <i class="fas fa-check-circle mr-2 text-green-500"></i>
                        {{ message }}
                    </div>
                {% endfor %}

                {% if error %}
                    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 flex items-center text-sm">
                        <i class="fas fa-exclamation-circle mr-2 text-red-500"></i>
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.session.get('login_error') %}
                    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 flex items-center text-sm">
                        <i class="fas fa-exclamation-circle mr-2 text-red-500"></i>
                        {{ app.session.get('login_error') }}
                    </div>
                    {% do app.session.remove('login_error') %}
                {% endif %}

                {% if app.user %}
                    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-6 flex items-center text-sm">
                        <i class="fas fa-check-circle mr-2 text-green-500"></i>
                        Bạn đã đăng nhập với tài khoản {{ app.user.studentId }}
                    </div>
                    <div class="flex flex-col gap-3">
                        <a href="{{ path('logout') }}" class="w-full text-center border border-red-200 text-red-600 hover:bg-red-50 font-medium py-2.5 px-4 rounded-xl transition-colors">
                            <i class="fas fa-sign-out-alt mr-2"></i>Đăng xuất
                        </a>
                        <a href="{{ path('app_home') }}" class="w-full text-center border border-indigo-200 text-indigo-600 hover:bg-indigo-50 font-medium py-2.5 px-4 rounded-xl transition-colors">
                            <i class="fas fa-home mr-2"></i>Về trang chủ
                        </a>
                    </div>
                {% else %}
                    <a href="{{ path('connect_google_start') }}" class="flex items-center justify-center w-full bg-white border border-slate-200 hover:bg-slate-50 hover:shadow-md text-slate-700 font-semibold py-3 px-4 rounded-xl transition-all duration-200 group">
                        <i class="fab fa-google text-red-500 text-xl mr-3 group-hover:scale-110 transition-transform"></i>
                        Đăng nhập bằng Google
                    </a>
                {% endif %}
            </div>

            <div class="bg-slate-50 border-t border-slate-100 p-4 text-center">
                <a href="{{ path('app_home') }}" class="text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors inline-flex items-center">
                    <i class="fas fa-arrow-left mr-2"></i>Quay lại trang chủ
                </a>
            </div>
        </div>
    </div>
</body>
</html>
