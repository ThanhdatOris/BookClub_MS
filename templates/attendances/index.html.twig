{% extends 'base.html.twig' %}

{% block title %}Attendances index{% endblock %}

{% block body %}
    <h1>Attendances index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Status</th>
                <th>Remark</th>
                <th>Marked_at</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for attendance in attendances %}
            <tr>
                <td>{{ attendance.id }}</td>
                <td>{{ attendance.status }}</td>
                <td>{{ attendance.remark }}</td>
                <td>{{ attendance.markedAt ? attendance.markedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_attendances_show', {'id': attendance.id}) }}">show</a>
                    <a href="{{ path('app_attendances_edit', {'id': attendance.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_attendances_new') }}">Create new</a>
{% endblock %}
