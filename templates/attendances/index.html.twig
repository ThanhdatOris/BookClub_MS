{% extends 'base.html.twig' %}

{% block title %}Quản lý điểm danh chung{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Quản lý điểm danh</h1>
                <p class="mt-2 text-sm text-gray-500">Giám sát và quản lý trạng thái tham gia của tất cả thành viên.</p>
            </div>
            <div class="flex gap-3">
                <button type="button" class="inline-flex items-center px-4 py-2 bg-indigo-600 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors" onclick="showAddForm()">
                    <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                    Thêm điểm danh
                </button>
            </div>
        </div>

        <!-- Alerts -->
        <div id="alert-container" class="mb-6 space-y-4">
            {% for message in app.flashes('success') %}
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl flex items-center shadow-sm">
                    <svg class="w-5 h-5 mr-3 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span class="text-sm font-medium">{{ message }}</span>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-xl flex items-center shadow-sm">
                    <svg class="w-5 h-5 mr-3 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span class="text-sm font-medium">{{ message }}</span>
                </div>
            {% endfor %}
        </div>

        <!-- Dynamic Content Panel -->
        <div id="dynamicContent" class="mb-8 scroll-mt-6 hidden">
            <!-- Populated via JS -->
        </div>

        <!-- Attendances List -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <!-- Table Header & Search -->
            <div class="px-6 py-5 border-b border-gray-100 bg-gray-50 flex flex-col sm:flex-row justify-between items-center gap-4">
                <h3 class="text-lg font-bold text-gray-800">Danh sách điểm danh</h3>
                <div class="relative w-full sm:w-auto">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <input type="text" id="searchInput" class="block w-full sm:w-80 pl-10 pr-3 py-2 border border-gray-200 rounded-xl leading-5 bg-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors" placeholder="Tìm kiếm tên, hoạt động...">
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-white">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tên thành viên</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Hoạt động</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Trạng thái</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Thời gian</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Hành động</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-100" id="attendanceTableBody">
                        {% for attendance in attendances %}
                            <tr class="hover:bg-gray-50 cursor-pointer transition-colors attendance-row" onclick="showAttendanceDetails('{{ attendance.id }}')">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="h-10 w-10 flex-shrink-0">
                                            <div class="h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-sm">
                                                {{ attendance.userId.name|first|upper }}
                                            </div>
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-medium text-gray-900 attendance-name">{{ attendance.userId.name }}</div>
                                            <div class="text-xs text-gray-500">{{ attendance.userId.studentId }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900 font-medium attendance-activity line-clamp-1" title="{{ attendance.activityId.title }}">{{ attendance.activityId.title }}</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% if attendance.status == 'present' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                                            Có mặt
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-800">
                                            Vắng mặt
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    {{ attendance.markedAt|date('d/m/Y H:i') }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <button type="button" class="text-rose-600 hover:text-rose-900 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-lg transition-colors ml-2" 
                                            onclick="event.stopPropagation(); deleteAttendance('{{ attendance.id }}', '{{ csrf_token('delete' ~ attendance.id) }}')">
                                        Xóa
                                    </button>
                                </td>
                            </tr>
                        {% else %}
                            <tr id="emptyRow">
                                <td colspan="5" class="px-6 py-12 text-center">
                                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 text-gray-400 mb-4">
                                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                                    </div>
                                    <h3 class="text-sm font-medium text-gray-900">Không có điểm danh</h3>
                                    <p class="mt-1 text-sm text-gray-500">Chưa có ai được điểm danh trên hệ thống.</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Hidden Form Templates -->
    <div id="form-templates" class="hidden">
        <!-- Add Form -->
        <div id="template-add">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transform transition-all duration-300">
                <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50">
                    <h3 class="text-lg font-bold text-gray-800">Thêm điểm danh mới</h3>
                    <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none" onclick="document.getElementById('dynamicContent').classList.add('hidden')">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                <div class="p-6">
                    <div id="addError" class="hidden mb-4 p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200"></div>
                    {{ form_start(addAttendanceForm, {'attr': {'id': 'addForm', 'class': 'space-y-6', 'onsubmit': 'submitForm(event, "addForm", "' ~ path('app_attendances_new') ~ '")'}}) }}
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                {{ form_label(addAttendanceForm.user_id, 'Thành viên', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(addAttendanceForm.user_id, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                            </div>
                            <div>
                                {{ form_label(addAttendanceForm.activity_id, 'Hoạt động', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(addAttendanceForm.activity_id, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                            </div>
                            <div>
                                {{ form_label(addAttendanceForm.status, 'Trạng thái', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(addAttendanceForm.status, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                            </div>
                            <div>
                                {{ form_label(addAttendanceForm.marked_at, 'Thời gian', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(addAttendanceForm.marked_at, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                            </div>
                            <div class="md:col-span-2">
                                {{ form_label(addAttendanceForm.remark, 'Ghi chú', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(addAttendanceForm.remark, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                            </div>
                            <div class="hidden">
                                {{ form_widget(addAttendanceForm.marked_by) }}
                            </div>
                        </div>
                        <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
                            <button type="button" class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" onclick="document.getElementById('dynamicContent').classList.add('hidden')">Hủy</button>
                            <button type="submit" class="px-4 py-2 bg-indigo-600 border border-transparent rounded-xl text-sm font-medium text-white hover:bg-indigo-700 transition-colors flex items-center">
                                <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white hidden" id="addForm-spinner" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                Lưu điểm danh
                            </button>
                        </div>
                    {{ form_end(addAttendanceForm) }}
                </div>
            </div>
        </div>

        <!-- Edit Forms -->
        {% for attendance in attendances %}
            <div id="template-edit-{{ attendance.id }}">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transform transition-all duration-300">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50">
                        <h3 class="text-lg font-bold text-gray-800">Chỉnh sửa điểm danh</h3>
                        <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none" onclick="showAttendanceDetails('{{ attendance.id }}')">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    <div class="p-6">
                        <div id="editError{{ attendance.id }}" class="hidden mb-4 p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200"></div>
                        {{ form_start(editAttendanceForms[attendance.id], {'attr': {'id': 'editForm' ~ attendance.id, 'class': 'space-y-6', 'onsubmit': 'submitForm(event, "editForm' ~ attendance.id ~ '", "' ~ path('app_attendances_edit', {'id': attendance.id}) ~ '")'}}) }}
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    {{ form_label(editAttendanceForms[attendance.id].user_id, 'Thành viên', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(editAttendanceForms[attendance.id].user_id, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                                <div>
                                    {{ form_label(editAttendanceForms[attendance.id].activity_id, 'Hoạt động', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(editAttendanceForms[attendance.id].activity_id, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                                <div>
                                    {{ form_label(editAttendanceForms[attendance.id].status, 'Trạng thái', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(editAttendanceForms[attendance.id].status, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                                <div>
                                    {{ form_label(editAttendanceForms[attendance.id].marked_at, 'Thời gian', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(editAttendanceForms[attendance.id].marked_at, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                                <div class="md:col-span-2">
                                    {{ form_label(editAttendanceForms[attendance.id].remark, 'Ghi chú', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(editAttendanceForms[attendance.id].remark, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                                <div class="hidden">
                                    {{ form_widget(editAttendanceForms[attendance.id].marked_by) }}
                                </div>
                            </div>
                            <div class="pt-4 border-t border-gray-100 flex justify-between gap-3">
                                <button type="button" class="px-4 py-2 bg-rose-50 border border-transparent rounded-xl text-sm font-medium text-rose-700 hover:bg-rose-100 transition-colors" onclick="deleteAttendance('{{ attendance.id }}', '{{ csrf_token('delete' ~ attendance.id) }}')">Xóa</button>
                                <div class="flex gap-3">
                                    <button type="button" class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" onclick="showAttendanceDetails('{{ attendance.id }}')">Quay lại</button>
                                    <button type="submit" class="px-4 py-2 bg-indigo-600 border border-transparent rounded-xl text-sm font-medium text-white hover:bg-indigo-700 transition-colors flex items-center">
                                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white hidden" id="editForm{{ attendance.id }}-spinner" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                        Lưu thay đổi
                                    </button>
                                </div>
                            </div>
                        {{ form_end(editAttendanceForms[attendance.id]) }}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- Script Store & Handlers -->
    <script>
        const store = {
            {% for a in attendances %}
                '{{ a.id }}': {
                    id: '{{ a.id }}',
                    userName: '{{ a.userId.name|e('js') }}',
                    userStudentId: '{{ a.userId.studentId|e('js') }}',
                    activityTitle: '{{ a.activityId.title|e('js') }}',
                    status: '{{ a.status }}',
                    remark: '{{ a.remark ? a.remark|e('js')|nl2br : 'N/A' }}',
                    markedAt: '{{ a.markedAt|date('d/m/Y H:i') }}',
                    markedBy: '{{ a.markedBy.name|e('js') }}'
                }{% if not loop.last %},{% endif %}
            {% endfor %}
        };

        // Client-side Search
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    const term = e.target.value.toLowerCase();
                    const rows = document.querySelectorAll('.attendance-row');
                    let visibleCount = 0;

                    rows.forEach(row => {
                        const name = row.querySelector('.attendance-name').textContent.toLowerCase();
                        const activity = row.querySelector('.attendance-activity').textContent.toLowerCase();
                        
                        if (name.includes(term) || activity.includes(term)) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    const emptyRow = document.getElementById('emptyRow');
                    if (visibleCount === 0 && rows.length > 0) {
                        if (!emptyRow) {
                            const tbody = document.getElementById('attendanceTableBody');
                            tbody.insertAdjacentHTML('beforeend', `
                                <tr id="emptyRow">
                                    <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500">
                                        Không tìm thấy kết quả phù hợp.
                                    </td>
                                </tr>
                            `);
                        } else {
                            emptyRow.style.display = '';
                        }
                    } else if (emptyRow) {
                        emptyRow.style.display = 'none';
                    }
                });
            }
        });

        function showAttendanceDetails(id) {
            const data = store[id];
            if (!data) return;

            const panel = document.getElementById('dynamicContent');
            panel.classList.remove('hidden');

            const typeBadge = data.status === 'present' 
                ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-emerald-100 text-emerald-800">Có mặt</span>'
                : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-rose-100 text-rose-800">Vắng mặt</span>';

            panel.innerHTML = `
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transform transition-all duration-300">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50">
                        <h3 class="text-lg font-bold text-gray-800">Chi tiết điểm danh</h3>
                        <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none" onclick="document.getElementById('dynamicContent').classList.add('hidden')">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div>
                                <h4 class="text-xl font-bold text-gray-900 mb-1">${data.userName}</h4>
                                <p class="text-sm text-gray-500 mb-6">Mã SV: ${data.userStudentId}</p>
                                
                                <div class="space-y-4">
                                    <div class="flex items-start text-sm">
                                        <span class="w-32 text-gray-500">Hoạt động:</span>
                                        <span class="font-medium text-gray-900">${data.activityTitle}</span>
                                    </div>
                                    <div class="flex items-center text-sm">
                                        <span class="w-32 text-gray-500">Trạng thái:</span>
                                        ${typeBadge}
                                    </div>
                                    <div class="flex items-center text-sm">
                                        <span class="w-32 text-gray-500">Thời gian:</span>
                                        <span class="font-medium text-gray-900">${data.markedAt}</span>
                                    </div>
                                    <div class="flex items-center text-sm">
                                        <span class="w-32 text-gray-500">Người ghi nhận:</span>
                                        <span class="font-medium text-gray-900">${data.markedBy}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
                                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Ghi chú</p>
                                <p class="text-sm text-gray-700 leading-relaxed">${data.remark}</p>
                            </div>
                        </div>
                        <div class="mt-6 flex flex-wrap gap-3 pt-6 border-t border-gray-100">
                            <button class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" onclick="showEditForm('${data.id}')">Chỉnh sửa</button>
                        </div>
                    </div>
                </div>
            `;
            window.scrollTo({ top: panel.offsetTop - 20, behavior: 'smooth' });
        }

        function showAddForm() {
            const template = document.getElementById('template-add');
            if (template) {
                const panel = document.getElementById('dynamicContent');
                panel.innerHTML = template.innerHTML;
                panel.classList.remove('hidden');
                window.scrollTo({ top: panel.offsetTop - 20, behavior: 'smooth' });
            }
        }

        function showEditForm(id) {
            const template = document.getElementById('template-edit-' + id);
            if (template) {
                const panel = document.getElementById('dynamicContent');
                panel.innerHTML = template.innerHTML;
                panel.classList.remove('hidden');
                window.scrollTo({ top: panel.offsetTop - 20, behavior: 'smooth' });
            }
        }

        function submitForm(e, formId, url) {
            e.preventDefault();
            const form = document.getElementById(formId);
            const spinner = document.getElementById(formId + '-spinner');
            const errorDiv = document.getElementById(formId.replace('Form', 'Error'));
            
            spinner.classList.remove('hidden');
            if (errorDiv) errorDiv.classList.add('hidden');
            
            fetch(url, {
                method: 'POST',
                body: new FormData(form)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                } else {
                    if (errorDiv) {
                        errorDiv.innerHTML = data.error || 'Có lỗi xảy ra';
                        errorDiv.classList.remove('hidden');
                    } else {
                        alert(data.error || 'Có lỗi xảy ra');
                    }
                }
            })
            .catch(err => alert('Lỗi kết nối'))
            .finally(() => spinner.classList.add('hidden'));
        }

        function deleteAttendance(id, csrfToken) {
            if (confirm('Bạn có chắc chắn muốn xóa bản ghi điểm danh này không?')) {
                const formData = new FormData();
                formData.append('_token', csrfToken);
                
                fetch(`/attendances/${id}`, {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        window.location.reload();
                    } else {
                        alert(data.error || 'Lỗi khi xóa');
                    }
                })
                .catch(err => alert('Lỗi kết nối'));
            }
        }
    </script>
{% endblock %}