<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{% block title %}Book Club CTUT{% endblock %}</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="{{ asset('assets/img/logo-ct-dark-mn76con.png') }}">
    
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('assets/styles/app.css') }}">
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased flex h-screen overflow-hidden">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-white shadow-xl flex-shrink-0 hidden md:flex flex-col">
        <div class="h-16 flex items-center px-6 border-b border-slate-100">
            <a href="{{ path('app_home') }}" class="flex items-center gap-3 font-bold text-lg text-indigo-600">
                <i class="fas fa-book-reader text-2xl"></i>
                <span>BOOK CLUB CTUT</span>
            </a>
        </div>
        <div class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
            <a href="{{ path('app_home') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-indigo-600 transition-colors {{ app.request.attributes.get('_route') == 'app_home' ? 'bg-indigo-50 text-indigo-600 font-medium' : '' }}">
                <i class="fas fa-home w-5 text-center"></i>
                Trang chủ
            </a>

            {% if app.user %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-indigo-600 transition-colors {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'bg-indigo-50 text-indigo-600 font-medium' : '' }}">
                        <i class="fas fa-tachometer-alt w-5 text-center"></i>
                        Dashboard
                    </a>
                    
                    <div class="pt-4 pb-1">
                        <p class="px-3 text-xs font-bold uppercase tracking-wider text-slate-400">Quản lý</p>
                    </div>
                    
                    <a href="{{ path('app_users_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-indigo-600 transition-colors {{ app.request.attributes.get('_route') == 'app_users_index' ? 'bg-indigo-50 text-indigo-600 font-medium' : '' }}">
                        <i class="fas fa-users w-5 text-center"></i>
                        Thành viên
                    </a>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_TREASURER') %}
                    <a href="{{ path('app_funds_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-indigo-600 transition-colors {{ app.request.attributes.get('_route') == 'app_funds_index' ? 'bg-indigo-50 text-indigo-600 font-medium' : '' }}">
                        <i class="fas fa-money-bill-wave w-5 text-center"></i>
                        Quỹ
                    </a>
                {% endif %}

                <a href="{{ path('app_activities_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-indigo-600 transition-colors {{ app.request.attributes.get('_route') == 'app_activities_index' ? 'bg-indigo-50 text-indigo-600 font-medium' : '' }}">
                    <i class="fas fa-calendar-alt w-5 text-center"></i>
                    Hoạt động
                </a>
                
                <a href="{{ path('app_proposals_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-indigo-600 transition-colors {{ app.request.attributes.get('_route') == 'app_proposals_index' ? 'bg-indigo-50 text-indigo-600 font-medium' : '' }}">
                    <i class="fas fa-file-alt w-5 text-center"></i>
                    Đề xuất
                </a>

                <div class="pt-4 pb-1">
                    <p class="px-3 text-xs font-bold uppercase tracking-wider text-slate-400">Tài khoản</p>
                </div>
                
                <a href="{{ path('profile', { studentId: app.user.studentId}) }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-indigo-600 transition-colors {{ app.request.attributes.get('_route') == 'profile' ? 'bg-indigo-50 text-indigo-600 font-medium' : '' }}">
                    <i class="fas fa-user w-5 text-center"></i>
                    Hồ sơ
                </a>
                
                <a href="{{ path('logout') }}" class="flex items-center gap-3 px-3 py-2 mt-4 rounded-lg text-red-500 hover:bg-red-50 transition-colors">
                    <i class="fas fa-sign-out-alt w-5 text-center"></i>
                    Đăng xuất
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="flex items-center gap-3 px-3 py-2 mt-4 rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition-colors shadow-md">
                    <i class="fas fa-sign-in-alt w-5 text-center"></i>
                    Đăng nhập
                </a>
            {% endif %}
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden">
        <!-- Top Navbar (Mobile only) -->
        <header class="h-16 bg-white shadow-sm flex items-center justify-between px-4 md:hidden">
            <a href="{{ path('app_home') }}" class="font-bold text-lg text-indigo-600">
                BOOK CLUB CTUT
            </a>
            <button id="mobile-menu-btn" class="p-2 text-slate-500 hover:bg-slate-100 rounded-lg" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
                <i class="fas fa-bars text-xl"></i>
            </button>
        </header>

        <!-- Main scrollable area -->
        <main class="flex-1 overflow-x-hidden overflow-y-auto bg-slate-50 p-6">
            <div class="max-w-7xl mx-auto">
                {% block body %}{% endblock %}
            </div>
        </main>
    </div>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 bg-slate-900/50 z-40 hidden md:hidden">
        <div class="w-64 bg-white h-full shadow-xl flex flex-col">
            <div class="h-16 flex items-center justify-between px-4 border-b border-slate-100">
                <span class="font-bold text-indigo-600">Menu</span>
                <button class="p-2 text-slate-500" onclick="document.getElementById('mobile-menu').classList.add('hidden')">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
                <!-- Mobile links, same as sidebar but for mobile -->
                <a href="{{ path('app_home') }}" class="block px-3 py-2 rounded-lg text-slate-600">Trang chủ</a>
                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_dashboard') }}" class="block px-3 py-2 rounded-lg text-slate-600">Dashboard</a>
                        <a href="{{ path('app_users_index') }}" class="block px-3 py-2 rounded-lg text-slate-600">Thành viên</a>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_TREASURER') %}
                        <a href="{{ path('app_funds_index') }}" class="block px-3 py-2 rounded-lg text-slate-600">Quỹ</a>
                    {% endif %}
                    <a href="{{ path('app_activities_index') }}" class="block px-3 py-2 rounded-lg text-slate-600">Hoạt động</a>
                    <a href="{{ path('app_proposals_index') }}" class="block px-3 py-2 rounded-lg text-slate-600">Đề xuất</a>
                    <a href="{{ path('profile', { studentId: app.user.studentId}) }}" class="block px-3 py-2 rounded-lg text-slate-600">Hồ sơ</a>
                    <a href="{{ path('logout') }}" class="block px-3 py-2 mt-4 rounded-lg text-red-500">Đăng xuất</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="block px-3 py-2 rounded-lg text-indigo-600 font-bold">Đăng nhập</a>
                {% endif %}
            </div>
        </div>
    </div>
</body>
</html>