{% extends 'base.html.twig' %}

{% block title %}Quản lý hoạt động{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <!-- Flash messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <!-- Activity Management -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header pb-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="text-uppercase text-secondary font-weight-bold mb-0">Quản lý hoạt động</h6>
                            <div class="d-flex align-items-center">
                                <div class="d-flex align-items-center me-2 mb-0">
                                    <input type="text" id="activitiesSearchInput" class="form-control me-2" placeholder="Tìm kiếm hoạt động..." style="max-width: 300px;">
                                    <button type="button" id="activitiesClearSearchBtn" class="btn btn-secondary mb-0 ms-2 d-none">Xóa bộ lọc</button>
                                </div>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <button type="button" class="btn btn-success mb-0" data-bs-toggle="modal" data-bs-target="#addActivityModal">
                                        <i class="fas fa-plus me-1"></i> Thêm hoạt động
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="card-body px-0 pt-0 pb-2">
                        <div class="table-responsive p-0 px-3" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-hover align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            <a href="#" class="sort-link" data-sort="title">Tiêu đề</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            <a href="#" class="sort-link" data-sort="date">Ngày</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            <a href="#" class="sort-link" data-sort="location">Địa điểm</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            <a href="#" class="sort-link" data-sort="status">Trạng thái</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            <a href="#" class="sort-link" data-sort="createdBy">Người tạo</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody id="activitiesTableBody">
                                    {% for activity in activities %}
                                        <tr data-id="{{ activity.id }}" style="cursor: pointer;">
                                            <td>
                                                <div class="d-flex px-2 py-1">
                                                    <div class="d-flex flex-column justify-content-center">
                                                        <h6 class="mb-0 text-sm">{{ activity.title|length > 25 ? activity.title|slice(0, 25) ~ '...' : activity.title }}</h6>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">{{ activity.date ? activity.date|date('Y-m-d') : 'N/A' }}</p>
                                            </td>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">{{ activity.location|length > 20 ? activity.location|slice(0, 20) ~ '...' : activity.location }}</p>
                                            </td>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0 text-{{ activity.status == 'planned' ? 'primary' : (activity.status == 'ongoing' ? 'success' : (activity.status == 'completed' ? 'info' : (activity.status == 'cancelled' ? 'danger' : 'secondary'))) }}">{{ activity.status }}</p>
                                            </td>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">{{ activity.createdBy.name }}</p>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-info mb-0 expand-btn" data-id="{{ activity.id }}" onclick="event.stopPropagation();">Chi tiết</button>
                                                <button type="button" class="btn btn-sm btn-primary mb-0" data-bs-toggle="modal" data-bs-target="#editActivityModal{{ activity.id }}" onclick="event.stopPropagation();">Sửa</button>
                                                {% if activity.status != 'cancelled' %}
                                                    <button type="button" class="btn btn-sm btn-danger mb-0 cancel-btn" data-id="{{ activity.id }}" data-csrf-token="{{ csrf_token('cancel' ~ activity.id) }}" onclick="event.stopPropagation();">Hủy</button>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center">Không có hoạt động nào.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <div class="navigation mt-4 d-flex justify-content-center">
                            <nav>
                                <ul class="pagination" id="activitiesPagination"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal: Thêm hoạt động -->
        <div class="modal fade" id="addActivityModal" tabindex="-1" aria-labelledby="addActivityModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addActivityModalLabel">Thêm hoạt động mới</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="d-none alert alert-danger" id="addActivityError"></div>
                        {{ form_start(addActivityForm, {'attr': {'id': 'addActivityForm'}}) }}
                            {{ form_widget(addActivityForm) }}
                            <button type="submit" class="btn btn-sm btn-success w-100">
                                <span class="spinner-border spinner-border-sm d-none" id="addActivitySpinner"></span>
                                Thêm
                            </button>
                        {{ form_end(addActivityForm) }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal: Sửa hoạt động -->
        {% for activity in activities %}
            <div class="modal fade" id="editActivityModal{{ activity.id }}" tabindex="-1" aria-labelledby="editActivityModalLabel{{ activity.id }}" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="editActivityModalLabel{{ activity.id }}">Chỉnh sửa hoạt động: {{ activity.title }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="d-none alert alert-danger" id="editActivityError{{ activity.id }}"></div>
                            {{ form_start(editActivityForms[activity.id], {'attr': {'id': 'editActivityForm' ~ activity.id}}) }}
                                {{ form_widget(editActivityForms[activity.id]) }}
                                <button type="submit" class="btn btn-sm btn-primary w-100">
                                    <span class="spinner-border spinner-border-sm d-none" id="editActivitySpinner{{ activity.id }}"></span>
                                    Lưu
                                </button>
                            {{ form_end(editActivityForms[activity.id]) }}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

        <!-- Modal: Attendance Floating Card -->
        {% for activity in activities %}
            <div class="modal fade" id="attendanceModal{{ activity.id }}" tabindex="-1" aria-labelledby="attendanceModalLabel{{ activity.id }}" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="attendanceModalLabel{{ activity.id }}">Điểm danh: {{ activity.title }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p><strong>ID Hoạt động:</strong> {{ activity.id }}</p>
                            <p><strong>Tên Hoạt động:</strong> {{ activity.title }}</p>
                            <p><strong>Số lượng tham gia:</strong> <span id="participantCount{{ activity.id }}">Đang tải...</span></p>
                            <h6>Danh sách tham gia:</h6>
                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>ID Người dùng</th>
                                            <th>Mã sinh viên</th>
                                            <th>Tên</th>
                                            <th>Điểm danh</th>
                                        </tr>
                                    </thead>
                                    <tbody id="participantList{{ activity.id }}">
                                        <!-- Populated via JavaScript -->
                                    </tbody>
                                </table>
                            </div>
                            <p><strong>Tổng số đã điểm danh:</strong> <span id="attendedCount{{ activity.id }}">Đang tải...</span></p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

        <!-- Include table-layout.js -->
        <script src="{{ asset('js/table-layout.js') }}"></script>

        <!-- JavaScript -->
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // TableLayout for Activities
                const activitiesTable = new TableLayout({
                    data: [
                        {% for activity in activities %}
                            {
                                id: '{{ activity.id }}',
                                title: '{{ activity.title|e('js') }}',
                                date: '{{ activity.date ? activity.date|date('Y-m-d') : 'N/A' }}',
                                location: '{{ activity.location ? activity.location|e('js') : 'N/A' }}',
                                status: '{{ activity.status|e('js') }}',
                                createdBy: '{{ activity.createdBy.name|e('js') }}',
                                actions: `
                                    <button type="button" class="btn btn-sm btn-info mb-0 expand-btn" data-id="{{ activity.id }}" onclick="event.stopPropagation();">Chi tiết</button>
                                    <button type="button" class="btn btn-sm btn-primary mb-0" data-bs-toggle="modal" data-bs-target="#editActivityModal{{ activity.id }}" onclick="event.stopPropagation();">Sửa</button>
                                    {% if activity.status != 'cancelled' %}
                                        <button type="button" class="btn btn-sm btn-danger mb-0 cancel-btn" data-id="{{ activity.id }}" data-csrf-token="{{ csrf_token('cancel' ~ activity.id) }}" onclick="event.stopPropagation();">Hủy</button>
                                    {% endif %}
                                `,
                                expandableContent: `
                                    <div class="p-3">
                                        <h6>{{ activity.title|e('js') }}</h6>
                                        <p><strong>Mô tả:</strong> {{ (activity.description ?: 'N/A')|e('js') }}</p>
                                        <p><strong>Thời gian:</strong> {{ activity.time ? activity.time|date('H:i') : 'N/A' }}</p>
                                        <p><strong>Địa điểm:</strong> {{ (activity.location ?: 'N/A')|e('js') }}</p>
                                        {% if activity.image %}
                                            <p><strong>Hình ảnh:</strong> <a href="{{ asset(activity.image)|e('js') }}" target="_blank">Xem</a></p>
                                        {% endif %}
                                        <p><strong>Số người tham gia:</strong> {{ activityParticipants[activity.id]|length }}</p>
                                        <div class="d-flex">
                                            <button type="button" class="btn btn-sm btn-primary me-2" data-bs-toggle="modal" data-bs-target="#editActivityModal{{ activity.id }}">Chỉnh sửa</button>
                                            <button type="button" class="btn btn-sm btn-success attendance-btn" data-bs-toggle="modal" data-bs-target="#attendanceModal{{ activity.id }}" data-id="{{ activity.id }}">Điểm danh</button>
                                        </div>
                                    </div>
                                `
                            },
                        {% endfor %}
                    ],
                    tableBodyId: 'activitiesTableBody',
                    searchInputId: 'activitiesSearchInput',
                    clearSearchBtnId: 'activitiesClearSearchBtn',
                    paginationId: 'activitiesPagination',
                    columns: [
                        {
                            field: 'title',
                            formatter: (value) => `
                                <div class="d-flex px-2 py-1">
                                    <div class="d-flex flex-column justify-content-center">
                                        <h6 class="mb-0 text-sm">${value.length > 25 ? value.slice(0, 25) + '...' : value}</h6>
                                    </div>
                                </div>
                            `
                        },
                        { field: 'date', type: 'date' },
                        {
                            field: 'location',
                            formatter: (value) => `<p class="text-xs font-weight-bold mb-0">${value.length > 20 ? value.slice(0, 20) + '...' : value}</p>`
                        },
                        {
                            field: 'status',
                            formatter: (value) => `
                                <p class="text-xs font-weight-bold mb-0 text-${value === 'planned' ? 'primary' : (value === 'ongoing' ? 'success' : (value === 'completed' ? 'info' : (value === 'cancelled' ? 'danger' : 'secondary')))}">${value}</p>
                            `
                        },
                        { field: 'createdBy' }
                    ],
                    onRowClick: (row) => {
                        const activityId = row.getAttribute('data-id');
                        activitiesTable.toggleExpandableRow(activityId);
                    },
                    onDelete: (button) => {
                        if (!confirm('Bạn có chắc chắn muốn hủy hoạt động này?')) return;
                        const id = button.getAttribute('data-id');
                        const csrfToken = button.getAttribute('data-csrf-token');
                        fetch(`/activities/${id}/cancel`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: `_token=${csrfToken}`
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) window.location.href = data.redirect;
                            else alert(data.error);
                        })
                        .catch(error => alert('Có lỗi xảy ra: ' + error.message));
                    },
                    scrollPositionKey: 'activities_table_scroll_position'
                });

                // Attendance modal data loading
                document.querySelectorAll('.attendance-btn').forEach(button => {
                    button.addEventListener('click', () => {
                        const activityId = button.getAttribute('data-id');
                        activitiesTable.loadAttendanceModal(activityId);
                    });
                });

                // Add Activity Form
                const addActivityForm = document.getElementById('addActivityForm');
                if (addActivityForm) {
                    addActivityForm.addEventListener('submit', function (e) {
                        e.preventDefault();
                        const submitBtn = addActivityForm.querySelector('button[type="submit"]');
                        const spinner = document.getElementById('addActivitySpinner');
                        const errorDiv = document.getElementById('addActivityError');
                        activitiesTable.showLoading(submitBtn, spinner);
                        activitiesTable.hideError(errorDiv);

                        fetch(addActivityForm.action, {
                            method: 'POST',
                            body: new FormData(addActivityForm)
                        })
                        .then(response => response.json())
                        .then(data => {
                            activitiesTable.hideLoading(submitBtn, spinner);
                            if (data.success) {
                                window.location.href = data.redirect;
                            } else {
                                activitiesTable.showError(errorDiv, data.error);
                            }
                        })
                        .catch(error => {
                            activitiesTable.hideLoading(submitBtn, spinner);
                            activitiesTable.showError(errorDiv, 'Có lỗi xảy ra: ' + error.message);
                        });
                    });
                }

                // Edit Activity Forms
                {% for activity in activities %}
                    const editActivityForm{{ activity.id }} = document.getElementById('editActivityForm{{ activity.id }}');
                    if (editActivityForm{{ activity.id }}) {
                        editActivityForm{{ activity.id }}.addEventListener('submit', function (e) {
                            e.preventDefault();
                            const submitBtn = editActivityForm{{ activity.id }}.querySelector('button[type="submit"]');
                            const spinner = document.getElementById('editActivitySpinner{{ activity.id }}');
                            const errorDiv = document.getElementById('editActivityError{{ activity.id }}');
                            activitiesTable.showLoading(submitBtn, spinner);
                            activitiesTable.hideError(errorDiv);

                            fetch(editActivityForm{{ activity.id }}.action, {
                                method: 'POST',
                                body: new FormData(editActivityForm{{ activity.id }})
                            })
                            .then(response => response.json())
                            .then(data => {
                                activitiesTable.hideLoading(submitBtn, spinner);
                                if (data.success) {
                                    window.location.href = data.redirect;
                                } else {
                                    activitiesTable.showError(errorDiv, data.error);
                                }
                            })
                            .catch(error => {
                                activitiesTable.hideLoading(submitBtn, spinner);
                                activitiesTable.showError(errorDiv, 'Có lỗi xảy ra: ' + error.message);
                            });
                        });
                    }
                {% endfor %}
            });
        </script>
    </div>
{% endblock %}