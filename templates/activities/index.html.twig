{% extends 'base.html.twig' %}

{% block title %}Activities index{% endblock %}

{% block body %}
    <h1>Activities index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th> {# Sửa lỗi chính tả từ "Descriptiton" thành "Description" #}
                <th>Date</th>
                <th>Time</th>
                <th>Location</th>
                <th>Status</th>
                <th>Created_at</th>
                <th>Updated_at</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for activity in activities %}
            <tr>
                <td>{{ activity.id }}</td>
                <td>{{ activity.title }}</td>
                <td>{{ activity.description }}</td> {# Sửa lỗi chính tả từ "descriptiton" thành "description" #}
                <td>{{ activity.date ? activity.date|date('Y-m-d') : '' }}</td>
                <td>{{ activity.time ? activity.time|date('H:i:s') : '' }}</td>
                <td>{{ activity.location }}</td>
                <td>{{ activity.status }}</td>
                <td>{{ activity.createdAt ? activity.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ activity.updatedAt ? activity.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_activities_show', {'id': activity.id}) }}">show</a>
                    {# Chỉ hiển thị nút "edit" nếu user có quyền chỉnh sửa #}
                    {% if is_granted('EDIT', activity) %}
                        <a href="{{ path('app_activities_edit', {'id': activity.id}) }}">edit</a>
                    {% endif %}
                    {# Chỉ hiển thị nút "delete" nếu user có quyền xóa #}
                    {% if is_granted('DELETE', activity) %}
                        <form method="post" action="{{ path('app_activities_delete', {'id': activity.id}) }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this activity?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ activity.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm">delete</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_activities_new') }}">Create new</a>
{% endblock %}