{% extends 'base.html.twig' %}

{% block title %}Quản lý hoạt động{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Quản lý hoạt động</h1>
                <p class="mt-2 text-sm text-gray-500">Lên lịch, theo dõi và điểm danh các hoạt động của câu lạc bộ.</p>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
                <button type="button" class="inline-flex items-center px-4 py-2 bg-indigo-600 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors" onclick="showAddForm()">
                    <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                    Thêm hoạt động mới
                </button>
            {% endif %}
        </div>

        <!-- Statistics Section -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            {% set stats = [
                {'title': 'Tổng số hoạt động', 'count': totalActivities, 'color': 'indigo', 'icon': 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z'},
                {'title': 'Đang diễn ra', 'count': ongoingActivities, 'color': 'green', 'icon': 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z'},
                {'title': 'Sắp diễn ra', 'count': pendingActivities, 'color': 'amber', 'icon': 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'},
                {'title': 'Đã kết thúc', 'count': completedActivities, 'color': 'gray', 'icon': 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'}
            ] %}
            
            {% for stat in stats %}
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex items-center justify-between hover:shadow-md transition-shadow">
                    <div>
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ stat.title }}</p>
                        <p class="mt-1 text-3xl font-bold text-gray-900">{{ stat.count }}</p>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-{{ stat.color }}-50 flex items-center justify-center">
                        <svg class="w-6 h-6 text-{{ stat.color }}-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ stat.icon }}"></path></svg>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Filters & Search -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 mb-8">
            <form action="{{ path('app_activities_index') }}" method="GET" class="flex flex-col sm:flex-row gap-4" id="searchForm">
                <div class="flex-1 relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <input type="text" name="search" value="{{ app.request.query.get('search') }}" class="block w-full pl-10 pr-3 py-2 border border-gray-200 rounded-xl leading-5 bg-gray-50 placeholder-gray-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors" placeholder="Tìm kiếm theo tiêu đề hoặc địa điểm...">
                </div>
                <div class="w-full sm:w-48">
                    <select name="status" class="block w-full px-3 py-2 border border-gray-200 rounded-xl bg-gray-50 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 sm:text-sm transition-colors" onchange="document.getElementById('searchForm').submit()">
                        <option value="">Tất cả trạng thái</option>
                        <option value="planned" {% if app.request.query.get('status') == 'planned' %}selected{% endif %}>Dự kiến</option>
                        <option value="ongoing" {% if app.request.query.get('status') == 'ongoing' %}selected{% endif %}>Đang diễn ra</option>
                        <option value="completed" {% if app.request.query.get('status') == 'completed' %}selected{% endif %}>Đã hoàn thành</option>
                        <option value="cancelled" {% if app.request.query.get('status') == 'cancelled' %}selected{% endif %}>Đã hủy</option>
                    </select>
                </div>
                <button type="submit" class="inline-flex justify-center items-center px-4 py-2 border border-gray-300 rounded-xl shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                    Tìm kiếm
                </button>
            </form>
        </div>

        <!-- Dynamic Content Panel -->
        <div id="dynamicContent" class="mb-8 scroll-mt-6 hidden">
            <!-- Populated via JS -->
        </div>

        <!-- Activities List Table -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tiêu đề</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Thời gian</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Địa điểm</th>
                            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Trạng thái</th>
                            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Người tạo</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-100">
                        {% for activity in activities %}
                            <tr class="hover:bg-gray-50 cursor-pointer transition-colors" onclick="showActivityDetails('{{ activity.id }}')">
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <div class="flex-shrink-0 h-10 w-10">
                                            {% if activity.image %}
                                                <img class="h-10 w-10 rounded-lg object-cover border border-gray-200 shadow-sm" src="{{ asset('uploads/activities/' ~ activity.image) }}" alt="">
                                            {% else %}
                                                <div class="h-10 w-10 rounded-lg bg-indigo-100 text-indigo-500 flex items-center justify-center">
                                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-semibold text-gray-900">{{ activity.title|length > 35 ? activity.title|slice(0, 35) ~ '...' : activity.title }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">{{ activity.date|date('d/m/Y') }}</div>
                                    <div class="text-xs text-gray-500">{{ activity.time ? activity.time|date('H:i') : '--:--' }}</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                    {{ activity.location|length > 20 ? activity.location|slice(0, 20) ~ '...' : activity.location }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    {% if activity.status == 'planned' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Dự kiến</span>
                                    {% elseif activity.status == 'ongoing' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Đang diễn ra</span>
                                    {% elseif activity.status == 'completed' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Đã kết thúc</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Đã hủy</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-center">
                                    {{ activity.createdBy.name }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center">
                                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 text-gray-400 mb-4">
                                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    </div>
                                    <h3 class="text-sm font-medium text-gray-900">Không tìm thấy hoạt động</h3>
                                    <p class="mt-1 text-sm text-gray-500">Không có hoạt động nào phù hợp với điều kiện tìm kiếm.</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            {% if activities.getTotalItemCount > 0 %}
                {{ knp_pagination_render(activities) }}
            {% endif %}
        </div>
    </div>

    <!-- Hidden Form Templates -->
    <div id="form-templates" class="hidden">
        <!-- Add Activity Form -->
        <div id="template-add-activity">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transform transition-all duration-300">
                <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50">
                    <h3 class="text-lg font-bold text-gray-800">Thêm hoạt động mới</h3>
                    <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none" onclick="document.getElementById('dynamicContent').classList.add('hidden')">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                <div class="p-6">
                    <div id="addActivityError" class="hidden mb-4 p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200" role="alert"></div>
                    {{ form_start(addActivityForm, {'attr': {'id': 'addActivityForm', 'class': 'space-y-6'}}) }}
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-4">
                                <div>
                                    {{ form_label(addActivityForm.title, 'Tiêu đề', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(addActivityForm.title, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                                <div>
                                    {{ form_label(addActivityForm.date, 'Ngày', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(addActivityForm.date, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                                <div>
                                    {{ form_label(addActivityForm.time, 'Thời gian', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(addActivityForm.time, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                            </div>
                            <div class="space-y-4">
                                <div>
                                    {{ form_label(addActivityForm.location, 'Địa điểm', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(addActivityForm.location, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                                <div>
                                    {{ form_label(addActivityForm.status, 'Trạng thái', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(addActivityForm.status, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                                <div>
                                    {{ form_label(addActivityForm.image, 'Hình ảnh', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(addActivityForm.image, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                            </div>
                        </div>
                        <div>
                            {{ form_label(addActivityForm.description, 'Mô tả', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                            {{ form_widget(addActivityForm.description, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors', 'rows': 4}}) }}
                        </div>
                        <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
                            <button type="button" class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition-colors" onclick="document.getElementById('dynamicContent').classList.add('hidden')">Hủy</button>
                            <button type="submit" class="px-4 py-2 bg-indigo-600 border border-transparent rounded-xl text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition-colors">
                                Thêm hoạt động
                            </button>
                        </div>
                    {{ form_end(addActivityForm) }}
                </div>
            </div>
        </div>

        <!-- Edit Activity Forms -->
        {% for activity in activities %}
            <div id="template-edit-activity-{{ activity.id }}">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transform transition-all duration-300">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50">
                        <h3 class="text-lg font-bold text-gray-800">Chỉnh sửa: {{ activity.title }}</h3>
                        <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none" onclick="document.getElementById('dynamicContent').classList.add('hidden')">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    <div class="p-6">
                        <div id="editActivityError{{ activity.id }}" class="hidden mb-4 p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200" role="alert"></div>
                        {{ form_start(editActivityForms[activity.id], {'attr': {'id': 'editActivityForm' ~ activity.id, 'class': 'space-y-6'}}) }}
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-4">
                                    <div>
                                        {{ form_label(editActivityForms[activity.id].title, 'Tiêu đề', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                        {{ form_widget(editActivityForms[activity.id].title, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                    </div>
                                    <div>
                                        {{ form_label(editActivityForms[activity.id].date, 'Ngày', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                        {{ form_widget(editActivityForms[activity.id].date, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                    </div>
                                    <div>
                                        {{ form_label(editActivityForms[activity.id].time, 'Thời gian', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                        {{ form_widget(editActivityForms[activity.id].time, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                    </div>
                                </div>
                                <div class="space-y-4">
                                    <div>
                                        {{ form_label(editActivityForms[activity.id].location, 'Địa điểm', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                        {{ form_widget(editActivityForms[activity.id].location, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                    </div>
                                    <div>
                                        {{ form_label(editActivityForms[activity.id].status, 'Trạng thái', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                        {{ form_widget(editActivityForms[activity.id].status, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                    </div>
                                    <div>
                                        {% if activity.image %}
                                            <div class="mb-2">
                                                <label class="block text-sm font-medium text-gray-700 mb-1">Hình ảnh hiện tại</label>
                                                <img src="{{ asset('uploads/activities/' ~ activity.image) }}" class="h-20 rounded-lg object-cover border border-gray-200 shadow-sm" alt="Preview">
                                            </div>
                                        {% endif %}
                                        {{ form_label(editActivityForms[activity.id].image, 'Thay đổi hình ảnh', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                        {{ form_widget(editActivityForms[activity.id].image, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                    </div>
                                </div>
                            </div>
                            <div>
                                {{ form_label(editActivityForms[activity.id].description, 'Mô tả', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(editActivityForms[activity.id].description, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors', 'rows': 4}}) }}
                            </div>
                            <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
                                <button type="button" class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition-colors" onclick="showActivityDetails('{{ activity.id }}')">Quay lại</button>
                                <button type="submit" class="px-4 py-2 bg-indigo-600 border border-transparent rounded-xl text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition-colors">
                                    Lưu thay đổi
                                </button>
                            </div>
                        {{ form_end(editActivityForms[activity.id]) }}
                    </div>
                </div>
            </div>
            
            <!-- Attendance Template -->
            <div id="template-attendance-{{ activity.id }}">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transform transition-all duration-300">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-indigo-600">
                        <h3 class="text-lg font-bold text-white">Điểm danh: {{ activity.title }}</h3>
                        <button type="button" class="text-indigo-200 hover:text-white focus:outline-none" onclick="showActivityDetails('{{ activity.id }}')">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-2 gap-4 mb-6">
                            <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
                                <p class="text-xs font-medium text-gray-500 uppercase">Tổng số người tham gia</p>
                                <p class="mt-1 text-2xl font-bold text-gray-900" id="participantCount{{ activity.id }}">Đang tải...</p>
                            </div>
                            <div class="bg-green-50 rounded-xl p-4 border border-green-100">
                                <p class="text-xs font-medium text-green-600 uppercase">Tổng số đã điểm danh</p>
                                <p class="mt-1 text-2xl font-bold text-green-700" id="attendedCount{{ activity.id }}">Đang tải...</p>
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <input type="text" id="participantSearch{{ activity.id }}" class="block w-full px-4 py-2 border border-gray-200 rounded-xl leading-5 bg-gray-50 placeholder-gray-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 sm:text-sm transition-colors" placeholder="Tìm kiếm tên hoặc mã SV...">
                        </div>
                        
                        <div class="overflow-x-auto border border-gray-100 rounded-xl">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mã SV</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Họ tên</th>
                                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Trạng thái</th>
                                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody id="participantList{{ activity.id }}" class="bg-white divide-y divide-gray-100">
                                    <tr><td colspan="4" class="px-6 py-4 text-center text-gray-500">Đang tải...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div id="attendanceError{{ activity.id }}" class="hidden mt-4 p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200"></div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <script>
        const isAdmin = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};
        const appUserId = {{ app.user ? app.user.id : 'null' }};
        
        // Pass essential data to JS safely
        const activitiesStore = {
            {% for activity in activities %}
                '{{ activity.id }}': {
                    id: '{{ activity.id }}',
                    title: '{{ activity.title|e('js') }}',
                    date: '{{ activity.date|date('d/m/Y') }}',
                    time: '{{ activity.time ? activity.time|date('H:i') : '--:--' }}',
                    location: '{{ activity.location|e('js') }}',
                    status: '{{ activity.status }}',
                    description: '{{ activity.description|e('js')|nl2br }}',
                    image: '{{ activity.image ? asset('uploads/activities/' ~ activity.image)|e('js') : '' }}',
                    participantsCount: {{ activityParticipants[activity.id]|default([])|length }},
                    hasJoined: {{ activityParticipants[activity.id]|default([])|filter(p => p.userId.id == app.user.id)|length > 0 ? 'true' : 'false' }},
                    joinCsrfToken: '{{ csrf_token('join' ~ activity.id) }}'
                }{% if not loop.last %},{% endif %}
            {% endfor %}
        };

        function showActivityDetails(id) {
            const act = activitiesStore[id];
            if (!act) return;

            const panel = document.getElementById('dynamicContent');
            panel.classList.remove('hidden');

            const statusBadge = act.status === 'planned' ? '<span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Dự kiến</span>'
                : act.status === 'ongoing' ? '<span class="px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">Đang diễn ra</span>'
                : act.status === 'completed' ? '<span class="px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Đã kết thúc</span>'
                : '<span class="px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">Đã hủy</span>';

            const adminButtons = isAdmin ? `
                <div class="mt-6 flex flex-wrap gap-3 pt-6 border-t border-gray-100">
                    <button class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition-colors" onclick="showEditForm('${act.id}')">Chỉnh sửa</button>
                    ${act.status !== 'cancelled' ? `
                        <button class="px-4 py-2 bg-indigo-600 border border-transparent rounded-xl text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition-colors" onclick="showAttendance('${act.id}')">Điểm danh</button>
                    ` : ''}
                </div>
            ` : '';

            const userButtons = !isAdmin && appUserId && (act.status === 'planned' || act.status === 'ongoing') && !act.hasJoined ? `
                <div class="mt-6 flex gap-3 pt-6 border-t border-gray-100">
                    <button class="px-4 py-2 bg-indigo-600 border border-transparent rounded-xl text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none shadow-sm transition-colors" onclick="handleJoinActivity('${act.id}')">Tham gia hoạt động</button>
                </div>
            ` : (!isAdmin && act.hasJoined ? `<div class="mt-6 pt-6 border-t border-gray-100"><span class="inline-flex items-center text-sm text-green-600 font-medium"><svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Bạn đã đăng ký tham gia</span></div>` : '');

            panel.innerHTML = `
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transform transition-all duration-300">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50">
                        <h3 class="text-lg font-bold text-gray-800">Chi tiết hoạt động</h3>
                        <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none" onclick="document.getElementById('dynamicContent').classList.add('hidden')">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    <div class="p-6">
                        <div class="flex flex-col md:flex-row gap-8">
                            <div class="md:w-2/3">
                                <div class="flex items-center gap-3 mb-4">
                                    <h4 class="text-2xl font-bold text-gray-900">${act.title}</h4>
                                    ${statusBadge}
                                </div>
                                
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                                    <div class="flex items-center text-gray-600">
                                        <div class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center mr-3">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                        </div>
                                        <div>
                                            <p class="text-xs font-medium text-gray-500 uppercase">Thời gian</p>
                                            <p class="text-sm font-semibold text-gray-900">${act.time} - ${act.date}</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center text-gray-600">
                                        <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mr-3">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                        </div>
                                        <div>
                                            <p class="text-xs font-medium text-gray-500 uppercase">Địa điểm</p>
                                            <p class="text-sm font-semibold text-gray-900">${act.location}</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center text-gray-600">
                                        <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center mr-3">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                                        </div>
                                        <div>
                                            <p class="text-xs font-medium text-gray-500 uppercase">Người tham gia</p>
                                            <p class="text-sm font-semibold text-gray-900">${act.participantsCount} người</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="prose prose-sm text-gray-600 max-w-none">
                                    <p class="text-xs font-medium text-gray-500 uppercase mb-2">Mô tả hoạt động</p>
                                    <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
                                        ${act.description || 'Không có mô tả.'}
                                    </div>
                                </div>
                                
                                ${adminButtons}
                                ${userButtons}
                            </div>
                            
                            <div class="md:w-1/3">
                                ${act.image ? `
                                    <div class="rounded-xl overflow-hidden shadow-sm border border-gray-200">
                                        <img src="${act.image}" alt="Banner" class="w-full h-auto object-cover">
                                    </div>
                                ` : `
                                    <div class="w-full h-48 rounded-xl bg-gray-50 border-2 border-dashed border-gray-200 flex flex-col items-center justify-center text-gray-400">
                                        <svg class="w-12 h-12 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                        <span class="text-sm">Không có hình ảnh</span>
                                    </div>
                                `}
                            </div>
                        </div>
                    </div>
                </div>
            `;
            window.scrollTo({ top: panel.offsetTop - 20, behavior: 'smooth' });
        }

        function showAddForm() {
            const template = document.getElementById('template-add-activity');
            if (template) {
                const panel = document.getElementById('dynamicContent');
                panel.innerHTML = template.innerHTML;
                panel.classList.remove('hidden');
                window.scrollTo({ top: panel.offsetTop - 20, behavior: 'smooth' });
            }
        }

        function showEditForm(id) {
            const template = document.getElementById('template-edit-activity-' + id);
            if (template) {
                const panel = document.getElementById('dynamicContent');
                panel.innerHTML = template.innerHTML;
                panel.classList.remove('hidden');
                window.scrollTo({ top: panel.offsetTop - 20, behavior: 'smooth' });
            }
        }

        function showAttendance(id) {
            const template = document.getElementById('template-attendance-' + id);
            if (template) {
                const panel = document.getElementById('dynamicContent');
                panel.innerHTML = template.innerHTML;
                panel.classList.remove('hidden');
                window.scrollTo({ top: panel.offsetTop - 20, behavior: 'smooth' });
                loadAttendanceData(id);
            }
        }

        function loadAttendanceData(activityId) {
            const list = document.getElementById(`participantList${activityId}`);
            const count = document.getElementById(`participantCount${activityId}`);
            const attended = document.getElementById(`attendedCount${activityId}`);
            const error = document.getElementById(`attendanceError${activityId}`);
            const search = document.getElementById(`participantSearch${activityId}`);

            fetch(`/activities/${activityId}/participants`)
                .then(res => res.json())
                .then(data => {
                    if (!data.success) throw new Error(data.error || 'Lỗi lấy dữ liệu');
                    count.textContent = data.totalParticipants;
                    attended.textContent = data.totalAttended;
                    
                    if (data.participants.length === 0) {
                        list.innerHTML = '<tr><td colspan="4" class="px-6 py-4 text-center text-sm text-gray-500">Chưa có ai tham gia.</td></tr>';
                        return;
                    }

                    list.innerHTML = data.participants.map(p => `
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${p.studentId || '-'}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${p.name}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                ${p.attended 
                                    ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Có mặt</span>' 
                                    : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Vắng</span>'}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <button class="px-3 py-1 rounded-lg text-xs font-medium ${p.attended ? 'bg-red-50 text-red-600 hover:bg-red-100' : 'bg-green-50 text-green-600 hover:bg-green-100'} transition-colors"
                                        onclick="toggleAttendance('${activityId}', '${p.id}', '${p.attended ? 'absent' : 'present'}')">
                                    ${p.attended ? 'Hủy điểm danh' : 'Điểm danh'}
                                </button>
                            </td>
                        </tr>
                    `).join('');

                    if (search) {
                        search.addEventListener('input', (e) => {
                            const query = e.target.value.toLowerCase();
                            Array.from(list.children).forEach(row => {
                                row.style.display = row.textContent.toLowerCase().includes(query) ? '' : 'none';
                            });
                        });
                    }
                })
                .catch(err => {
                    error.textContent = err.message;
                    error.classList.remove('hidden');
                });
        }

        function toggleAttendance(activityId, userId, newStatus) {
            fetch('/activities/attendance/toggle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ activity_id: activityId, user_id: userId, status: newStatus })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    loadAttendanceData(activityId);
                } else {
                    alert(data.error || 'Lỗi cập nhật');
                }
            })
            .catch(err => alert('Lỗi kết nối'));
        }
    </script>
{% endblock %}
