{% extends 'base.html.twig' %}

{% block title %}Quản lý hoạt động{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <!-- Flash messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <!-- Dynamic Content -->
        <div id="dynamicContent" class="mb-4">
            <div class="alert alert-info text-center text-white">Chọn một hoạt động để xem chi tiết</div>
        </div>

        <!-- Activity Management -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header pb-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="text-uppercase text-secondary font-weight-bold mb-0">Quản lý hoạt động</h6>
                            <div class="d-flex align-items-center">
                                <div class="d-flex align-items-center me-2 mb-0">
                                    <input type="text" id="activitiesSearchInput" class="form-control me-2" placeholder="Tìm kiếm hoạt động..." style="max-width: 300px;">
                                    <button type="button" id="activitiesClearSearchBtn" class="btn btn-sm btn-secondary mb-0 ms-2 d-none">Xóa bộ lọc</button>
                                </div>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <button type="button" class="btn btn-sm btn-success mb-0" data-bs-toggle="modal" data-bs-target="#addActivityModal">
                                        <i class="fas fa-plus me-1"></i> Thêm hoạt động
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="card-body px-0 pt-0 pb-2">
                        <div class="table-responsive p-0 px-3" style="max-height: 1080px; overflow-y: auto;">
                            <table class="table table-hover align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            <a href="#" class="sort-link" data-sort="title">Tiêu đề</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            <a href="#" class="sort-link" data-sort="date">Ngày</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            <a href="#" class="sort-link" data-sort="location">Địa điểm</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            <a href="#" class="sort-link" data-sort="status">Trạng thái</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            <a href="#" class="sort-link" data-sort="createdBy">Người tạo</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody id="activitiesTableBody">
                                    
                                </tbody>
                            </table>
                        </div>
                        <div class="navigation mt-4 d-flex justify-content-center">
                            <nav>
                                <ul class="pagination" id="activitiesPagination"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal: Thêm hoạt động -->
        <div class="modal fade" id="addActivityModal" tabindex="-1" aria-labelledby="addActivityModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addActivityModalLabel">Thêm hoạt động mới</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none" id="addActivityError"></div>
                        {{ form_start(addActivityForm, {'attr': {'id': 'addActivityForm'}}) }}
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(addActivityForm.title, 'Tiêu đề', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(addActivityForm.title, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(addActivityForm.date, 'Ngày', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(addActivityForm.date, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(addActivityForm.time, 'Thời gian', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(addActivityForm.time, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(addActivityForm.location, 'Địa điểm', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(addActivityForm.location, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(addActivityForm.status, 'Trạng thái', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(addActivityForm.status, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(addActivityForm.image, 'Hình ảnh', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(addActivityForm.image, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                {{ form_label(addActivityForm.description, 'Mô tả', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(addActivityForm.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                            </div>
                            <button type="submit" class="btn btn-sm btn-success w-100">
                                <span class="spinner-border spinner-border-sm d-none" id="addActivitySpinner"></span>
                                Thêm hoạt động
                            </button>
                        {{ form_end(addActivityForm) }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal: Sửa hoạt động -->
        {% for activity in activities %}
            <div class="modal fade" id="editActivityModal{{ activity.id }}" tabindex="-1" aria-labelledby="editActivityModalLabel{{ activity.id }}" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="editActivityModalLabel{{ activity.id }}">Chỉnh sửa hoạt động: {{ activity.title }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-danger d-none" id="editActivityError{{ activity.id }}"></div>
                            {{ form_start(editActivityForms[activity.id], {'attr': {'id': 'editActivityForm' ~ activity.id}}) }}
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            {{ form_label(editActivityForms[activity.id].title, 'Tiêu đề', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(editActivityForms[activity.id].title, {'attr': {'class': 'form-control'}}) }}
                                        </div>
                                        <div class="mb-3">
                                            {{ form_label(editActivityForms[activity.id].date, 'Ngày', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(editActivityForms[activity.id].date, {'attr': {'class': 'form-control'}}) }}
                                        </div>
                                        <div class="mb-3">
                                            {{ form_label(editActivityForms[activity.id].time, 'Thời gian', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(editActivityForms[activity.id].time, {'attr': {'class': 'form-control'}}) }}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            {{ form_label(editActivityForms[activity.id].location, 'Địa điểm', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(editActivityForms[activity.id].location, {'attr': {'class': 'form-control'}}) }}
                                        </div>
                                        <div class="mb-3">
                                            {{ form_label(editActivityForms[activity.id].status, 'Trạng thái', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(editActivityForms[activity.id].status, {'attr': {'class': 'form-control'}}) }}
                                        </div>
                                        <div class="mb-3">
                                            {{ form_label(editActivityForms[activity.id].image, 'Hình ảnh', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(editActivityForms[activity.id].image, {'attr': {'class': 'form-control'}}) }}
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    {{ form_label(editActivityForms[activity.id].description, 'Mô tả', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(editActivityForms[activity.id].description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary w-100">
                                    <span class="spinner-border spinner-border-sm d-none" id="editActivitySpinner{{ activity.id }}"></span>
                                    Lưu thay đổi
                                </button>
                            {{ form_end(editActivityForms[activity.id]) }}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

        <!-- Modal: Điểm danh -->
        {% for activity in activities %}
            <div class="modal fade" id="attendanceModal{{ activity.id }}" tabindex="-1" aria-labelledby="attendanceModalLabel{{ activity.id }}" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header bg-gradient-primary text-white">
                            <h5 class="modal-title" id="attendanceModalLabel{{ activity.id }}">Điểm danh: {{ activity.title }}</h5>
                            <button type="button" class="btn-close text-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <p><strong>ID Hoạt động:</strong> {{ activity.id }}</p>
                                    <p><strong>Tên Hoạt động:</strong> {{ activity.title }}</p>
                                </div>
                                <div class="col-md-6 text-end">
                                    <p><strong>Số lượng tham gia:</strong> <span id="participantCount{{ activity.id }}">Đang tải...</span></p>
                                    <p><strong>Tổng số đã điểm danh:</strong> <span id="attendedCount{{ activity.id }}">Đang tải...</span></p>
                                </div>
                            </div>
                            <div class="mb-3">
                                <input type="text" id="participantSearch{{ activity.id }}" class="form-control" placeholder="Tìm kiếm thành viên...">
                            </div>
                            <h6 class="text-uppercase text-secondary font-weight-bold">Danh sách tham gia:</h6>
                            <div class="table-responsive">
                                <table class="table table-bordered align-items-center mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">ID Người dùng</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Mã sinh viên</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Tên</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Điểm danh</th>
                                        </tr>
                                    </thead>
                                    <tbody id="participantList{{ activity.id }}">
                                        <!-- Populated via JavaScript -->
                                    </tbody>
                                </table>
                            </div>
                            <div class="alert alert-danger d-none mt-3" id="attendanceError{{ activity.id }}"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

        <!-- Include table-layout.js -->
        <script src="{{ asset('js/table-layout.js') }}"></script>

        <!-- JavaScript -->
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Kiểm tra quyền admin
                const isAdmin = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};

                // Dữ liệu hoạt động
                const activitiesData = [
                    {% for activity in activities %}
                        {
                            id: '{{ activity.id }}',
                            title: '{{ activity.title|e('js') }}',
                            date: '{{ activity.date ? activity.date|date('Y-m-d') : 'N/A' }}',
                            location: '{{ activity.location ? activity.location|e('js') : 'N/A' }}',
                            status: '{{ activity.status|e('js') }}',
                            createdBy: '{{ activity.createdBy.name|e('js') }}',
                            description: '{{ (activity.description ?: 'N/A')|e('js') }}',
                            time: '{{ activity.time ? activity.time|date('H:i') : 'N/A' }}',
                            image: '{{ activity.image ? asset(activity.image)|e('js') : '' }}',
                            participantsCount: {{ activityParticipants[activity.id]|default([])|length }},
                            action: `
                                {% if is_granted('ROLE_ADMIN') %}
                                    <button type="button" class="btn btn-sm btn-primary mb-0" data-bs-toggle="modal" data-bs-target="#editActivityModal{{ activity.id }}" onclick="event.stopPropagation();">Sửa</button>
                                    {% if activity.status != 'cancelled' and activity.status != 'completed' %}
                                        <button type="button" class="btn btn-sm btn-danger cancel-btn mb-0" data-id="{{ activity.id }}" data-csrf-token="{{ csrf_token('cancel' ~ activity.id) }}" onclick="event.stopPropagation();">Hủy</button>
                                    {% endif %}
                                {% endif %}
                            `
                        },
                    {% endfor %}
                ];

                // Debug: Kiểm tra dữ liệu
                console.log('Activities Data:', activitiesData);

                // TableLayout for Activities
                const activitiesTable = new TableLayout({
                    data: activitiesData,
                    tableBodyId: 'activitiesTableBody',
                    searchInputId: 'activitiesSearchInput',
                    clearSearchBtnId: 'activitiesClearSearchBtn',
                    paginationId: 'activitiesPagination',
                    columns: [
                        {
                            field: 'title',
                            formatter: (value, data) => `
                                <div class="d-flex px-2 py-1" data-id="${data.id}">
                                    <div class="d-flex flex-column justify-content-center" data-id="${data.id}">
                                        <h6 class="mb-0 text-sm" data-id="${data.id}">${value.length > 25 ? value.slice(0, 25) + '...' : value}</h6>
                                    </div>
                                </div>
                            `
                        },
                        { field: 'date', type: 'date' },
                        {
                            field: 'location',
                            formatter: (value, data) => `<p class="text-xs font-weight-bold mb-0" data-id="${data.id}">${value.length > 20 ? value.slice(0, 20) + '...' : value}</p>`
                        },
                        {
                            field: 'status',
                            formatter: (value, data) => `
                                <span class="badge bg-${value === 'planned' ? 'primary' : (value === 'ongoing' ? 'success' : (value === 'completed' ? 'info' : 'danger'))}" data-id="${data.id}">${value}</span>
                            `
                        },
                        { field: 'createdBy' },
                        {
                            field: 'action',
                            formatter: (value, data) => value,
                            className: 'text-center'
                        }
                    ],
                    onRowClick: (row) => {
                        const activityId = row.getAttribute('data-id'); // Lấy ID từ thuộc tính data-id
                        if (!activityId) {
                            console.error('Invalid row clicked:', row);
                            return;
                        }

                        window.scrollTo({
                            top: 0,
                            behavior: 'smooth' // Cuộn mượt
                        });

                        const activity = activitiesData.find(a => a.id === activityId);
                        if (activity) {
                            displayActivityDetails(activity);
                        } else {
                            console.error('Activity not found for ID:', activityId);
                        }
                    },
                    rowAttributes: (row, data) => {
                        row.setAttribute('data-id', data.id); // Thêm thuộc tính data-id vào mỗi hàng
                    },
                    onDelete: (button) => {
                        if (!confirm('Bạn có chắc chắn muốn hủy hoạt động này?')) return;
                        const id = button.getAttribute('data-id');
                        const csrfToken = button.getAttribute('data-csrf-token');
                        fetch(`/activities/${id}/cancel`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: `_token=${csrfToken}`
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) window.location.href = data.redirect;
                            else alert(data.error || 'Có lỗi xảy ra.');
                        })
                        .catch(error => alert('Có lỗi xảy ra: ' + error.message));
                    },
                    scrollPositionKey: 'activities_table_scroll_position'
                });

                // Listener thủ công cho click hàng
                document.getElementById('activitiesTableBody').addEventListener('click', (e) => {
                    // Tìm `data-id` từ phần tử được nhấn
                    const activityId = e.target.getAttribute('data-id');
                    if (!activityId) {
                        console.error('Invalid element clicked:', e.target);
                        return;
                    }

                    console.log('Row clicked:', activityId); // Debug
                    const activity = activitiesData.find(a => a.id === activityId);
                    if (activity) {
                        displayActivityDetails(activity);
                    } else {
                        console.error('Activity not found for ID:', activityId);
                    }
                });

                // Khai báo currentActivityId
                let currentActivityId = null;

                // Hiển thị chi tiết hoạt động trong dynamicContent
                function displayActivityDetails(activity) {
                    if (!activity) {
                        console.error("Activity data is missing.");
                        return;
                    }

                    const dynamicContent = document.getElementById('dynamicContent');
                    if (!dynamicContent) {
                        console.error("Element with ID 'dynamicContent' not found.");
                        return;
                    }

                    if (currentActivityId === activity.id) return;
                    currentActivityId = activity.id;

                    dynamicContent.innerHTML = `
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">${activity.title}</h6>
                                <button type="button" class="btn-close" aria-label="Đóng" onclick="resetDynamicContent()"></button>
                            </div>
                            <div class="card-body">
                                <p><strong>Mô tả:</strong> ${activity.description}</p>
                                <p><strong>Thời gian:</strong> ${activity.time}</p>
                                <p><strong>Địa điểm:</strong> ${activity.location}</p>
                                ${activity.image ? `<p><strong>Hình ảnh:</strong> <a href="${activity.image}" target="_blank">Xem</a></p>` : ''}
                                <p><strong>Số người tham gia:</strong> ${activity.participantsCount}</p>
                                <div class="d-flex">
                                    ${isAdmin ? `
                                        <button type="button" class="btn btn-sm btn-primary me-2" data-bs-toggle="modal" data-bs-target="#editActivityModal${activity.id}">Chỉnh sửa</button>
                                        ${activity.status !== 'cancelled' ? `
                                            <button type="button" class="btn btn-sm btn-success attendance-btn" data-bs-toggle="modal" data-bs-target="#attendanceModal${activity.id}" data-id="${activity.id}">Điểm danh</button>
                                        ` : ''}
                                    ` : ''}
                                </div>
                            </div>
                        </div>
                    `;
                }

                // Reset dynamicContent về trạng thái mặc định
                function resetDynamicContent() {
                    currentActivityId = null;
                    document.getElementById('dynamicContent').innerHTML = `
                        <div class="alert alert-info text-center text-white">Chọn một hoạt động để xem chi tiết</div>
                    `;
                }

                // Xử lý modal điểm danh
                document.addEventListener('click', function (event) {
                    const button = event.target.closest('.attendance-btn');
                    if (button) {
                        if (!isAdmin) {
                            alert('Chỉ admin mới có thể điểm danh.');
                            return;
                        }
                        const activityId = button.getAttribute('data-id');
                        loadAttendanceModal(activityId);
                    }
                });

                // Hàm tải dữ liệu điểm danh
                function loadAttendanceModal(activityId) {
                    const participantList = document.getElementById(`participantList${activityId}`);
                    const participantCount = document.getElementById(`participantCount${activityId}`);
                    const attendedCount = document.getElementById(`attendedCount${activityId}`);
                    const errorDiv = document.getElementById(`attendanceError${activityId}`);
                    const searchInput = document.getElementById(`participantSearch${activityId}`);

                    participantList.innerHTML = '<tr><td colspan="4">Đang tải...</td></tr>';
                    participantCount.textContent = 'Đang tải...';
                    attendedCount.textContent = 'Đang tải...';
                    errorDiv.classList.add('d-none');

                    fetch(`/activities/${activityId}/participants`)
                        .then(response => response.json())
                        .then(data => {
                            if (!data.success) {
                                throw new Error(data.error || 'Không thể tải dữ liệu.');
                            }

                            participantCount.textContent = data.totalParticipants;
                            attendedCount.textContent = data.totalAttended;
                            participantList.innerHTML = '';

                            data.participants.forEach(participant => {
                                const row = document.createElement('tr');
                                row.innerHTML = `
                                    <td>${participant.id}</td>
                                    <td>${participant.studentId || 'N/A'}</td>
                                    <td>${participant.name}</td>
                                    <td>
                                        <button class="btn btn-sm btn-${participant.attended ? 'success' : 'danger'} attendance-toggle-btn mb-0"
                                                data-activity-id="${activityId}"
                                                data-user-id="${participant.id}"
                                                data-status="${participant.attended ? 'present' : 'absent'}"
                                                ${isAdmin ? '' : 'disabled'}>
                                            ${participant.attended ? 'Có mặt' : 'Vắng'}
                                        </button>
                                    </td>
                                `;
                                participantList.appendChild(row);
                            });

                            searchInput.addEventListener('input', () => {
                                const query = searchInput.value.toLowerCase();
                                Array.from(participantList.children).forEach(row => {
                                    const text = row.textContent.toLowerCase();
                                    row.style.display = text.includes(query) ? '' : 'none';
                                });
                            });

                            document.querySelectorAll(`#participantList${activityId} .attendance-toggle-btn`).forEach(btn => {
                                btn.addEventListener('click', () => {
                                    const userId = btn.getAttribute('data-user-id');
                                    const currentStatus = btn.getAttribute('data-status');
                                    const newStatus = currentStatus === 'present' ? 'absent' : 'present';

                                    fetch('/activities/attendance/toggle', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ activity_id: activityId, user_id: userId, status: newStatus })
                                    })
                                    .then(response => response.json())
                                    .then(data => {
                                        if (data.success) {
                                            // Cập nhật lại modal sau khi trạng thái thay đổi
                                            loadAttendanceModal(activityId);
                                        } else {
                                            errorDiv.textContent = data.error || 'Không thể cập nhật trạng thái.';
                                            errorDiv.classList.remove('d-none');
                                        }
                                    })
                                    .catch(error => {
                                        errorDiv.textContent = 'Lỗi: ' + error.message;
                                        errorDiv.classList.remove('d-none');
                                    });
                                });
                            });
                        })
                        .catch(error => {
                            participantList.innerHTML = '<tr><td colspan="4">Lỗi: Không thể tải dữ liệu.</td></tr>';
                            participantCount.textContent = 'N/A';
                            attendedCount.textContent = 'N/A';
                            errorDiv.textContent = 'Lỗi: ' + error.message;
                            errorDiv.classList.remove('d-none');
                        });
                }

                // Thêm hoạt động
                const addActivityForm = document.getElementById('addActivityForm');
                if (addActivityForm) {
                    addActivityForm.addEventListener('submit', function (e) {
                        e.preventDefault();
                        const submitBtn = addActivityForm.querySelector('button[type="submit"]');
                        const spinner = document.getElementById('addActivitySpinner');
                        const errorDiv = document.getElementById('addActivityError');
                        activitiesTable.showLoading(submitBtn, spinner);
                        activitiesTable.hideError(errorDiv);

                        fetch(addActivityForm.action, {
                            method: 'POST',
                            body: new FormData(addActivityForm)
                        })
                        .then(response => response.json())
                        .then(data => {
                            activitiesTable.hideLoading(submitBtn, spinner);
                            if (data.success) {
                                window.location.href = data.redirect;
                            } else {
                                activitiesTable.showError(errorDiv, data.error || 'Dữ liệu không hợp lệ.');
                            }
                        })
                        .catch(error => {
                            activitiesTable.hideLoading(submitBtn, spinner);
                            activitiesTable.showError(errorDiv, 'Lỗi: ' + error.message);
                        });
                    });
                }

                // Sửa hoạt động
                {% for activity in activities %}
                    const editActivityForm{{ activity.id }} = document.getElementById('editActivityForm{{ activity.id }}');
                    if (editActivityForm{{ activity.id }}) {
                        editActivityForm{{ activity.id }}.addEventListener('submit', function (e) {
                            e.preventDefault();
                            const submitBtn = editActivityForm{{ activity.id }}.querySelector('button[type="submit"]');
                            const spinner = document.getElementById('editActivitySpinner{{ activity.id }}');
                            const errorDiv = document.getElementById('editActivityError{{ activity.id }}');
                            activitiesTable.showLoading(submitBtn, spinner);
                            activitiesTable.hideError(errorDiv);

                            fetch(editActivityForm{{ activity.id }}.action, {
                                method: 'POST',
                                body: new FormData(editActivityForm{{ activity.id }})
                            })
                            .then(response => response.json())
                            .then(data => {
                                activitiesTable.hideLoading(submitBtn, spinner);
                                if (data.success) {
                                    window.location.href = data.redirect;
                                } else {
                                    activitiesTable.showError(errorDiv, data.error || 'Dữ liệu không hợp lệ.');
                                }
                            })
                            .catch(error => {
                                activitiesTable.hideLoading(submitBtn, spinner);
                                activitiesTable.showError(errorDiv, 'Lỗi: ' + error.message);
                            });
                        });
                    }
                {% endfor %}
            });
        </script>
    </div>
{% endblock %}