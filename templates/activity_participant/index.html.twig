{% extends 'base.html.twig' %}

{% block title %}ActivityParticipant index{% endblock %}

{% block body %}
    <h1>ActivityParticipant index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Joined_at</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for activity_participant in activity_participants %}
            <tr>
                <td>{{ activity_participant.id }}</td>
                <td>{{ activity_participant.joinedAt ? activity_participant.joinedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_activity_participant_show', {'id': activity_participant.id}) }}">show</a>
                    <a href="{{ path('app_activity_participant_edit', {'id': activity_participant.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_activity_participant_new') }}">Create new</a>
{% endblock %}
