{% extends 'base.html.twig' %}

{% block title %}Tài khoản cá nhân - {{ user.name }}{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Hồ sơ cá nhân</h1>
                <p class="mt-2 text-sm text-gray-500">Xem và quản lý thông tin tài khoản của bạn.</p>
            </div>
            <div class="flex gap-3">
                {% if app.user and app.user.id == user.id and is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('profile_edit', {'studentId': user.studentId}) }}" class="inline-flex items-center px-4 py-2 bg-indigo-600 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        Chỉnh sửa thông tin
                    </a>
                {% else %}
                    <a href="{{ path('profile_suggest', {'studentId': user.studentId}) }}" class="inline-flex items-center px-4 py-2 bg-amber-500 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 transition-colors">
                        <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                        Đề xuất chỉnh sửa
                    </a>
                {% endif %}
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Left Column: Personal Info -->
            <div class="lg:col-span-1 space-y-8">
                <!-- Profile Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="h-32 bg-gradient-to-r from-indigo-500 to-purple-600"></div>
                    <div class="px-6 pb-6 relative">
                        <div class="-mt-16 mb-4 flex justify-center">
                            <div class="w-32 h-32 rounded-full border-4 border-white bg-white shadow-md overflow-hidden flex items-center justify-center">
                                <div class="w-full h-full bg-indigo-100 flex items-center justify-center text-indigo-500 text-5xl font-bold">
                                    {{ user.name|first|upper }}
                                </div>
                            </div>
                        </div>
                        <div class="text-center mb-6">
                            <h2 class="text-2xl font-bold text-gray-900">{{ user.name }}</h2>
                            <p class="text-sm font-medium text-gray-500">{{ user.studentId }}</p>
                            <div class="mt-3">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium {{ user.status == 'active' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' }}">
                                    {{ user.status == 'active' ? 'Đang hoạt động' : 'Không hoạt động' }}
                                </span>
                            </div>
                        </div>
                        <div class="border-t border-gray-100 pt-4 mt-4">
                            <dl class="space-y-3 text-sm">
                                <div class="flex justify-between">
                                    <dt class="text-gray-500 flex items-center"><svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>Email</dt>
                                    <dd class="font-medium text-gray-900">{{ user.email }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-gray-500 flex items-center"><svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>Điện thoại</dt>
                                    <dd class="font-medium text-gray-900">{{ user.contactInfo ?: 'Chưa cập nhật' }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-gray-500 flex items-center"><svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>Lớp</dt>
                                    <dd class="font-medium text-gray-900">{{ user.classId ?: 'Chưa cập nhật' }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-gray-500 flex items-center"><svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>Khoa</dt>
                                    <dd class="font-medium text-gray-900">{{ user.faculty ?: 'Chưa cập nhật' }}</dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>

                <!-- Stats Card -->
                <div class="bg-indigo-600 rounded-2xl shadow-sm border border-indigo-700 p-6 text-white">
                    <h3 class="text-lg font-bold mb-2">Thống kê hoạt động</h3>
                    <p class="text-indigo-200 text-sm mb-6">Tổng quan về sự tham gia của bạn trong câu lạc bộ.</p>
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-4xl font-extrabold">{{ activityCount }}</p>
                            <p class="text-sm text-indigo-200 mt-1">Hoạt động đã tham gia</p>
                        </div>
                        <div class="w-16 h-16 rounded-full bg-indigo-500 flex items-center justify-center">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Activity History -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden flex flex-col h-full">
                    <div class="px-6 py-5 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
                        <h3 class="text-lg font-bold text-gray-800">Lịch sử hoạt động</h3>
                    </div>
                    
                    <div class="flex-1 overflow-auto">
                        {% if participatedActivities|length > 0 %}
                            <ul class="divide-y divide-gray-100">
                                {% for participant in participatedActivities %}
                                    <li class="p-6 hover:bg-gray-50 transition-colors cursor-pointer" onclick="window.location.href='{{ path('app_activities_show', {'id': participant.activityId.id}) }}'">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-start gap-4">
                                                <div class="w-12 h-12 rounded-xl flex-shrink-0 flex items-center justify-center shadow-sm text-white
                                                    {% if participant.activityId.status == 'planned' %}bg-indigo-500
                                                    {% elseif participant.activityId.status == 'ongoing' %}bg-amber-500
                                                    {% elseif participant.activityId.status == 'completed' %}bg-emerald-500
                                                    {% else %}bg-rose-500{% endif %}">
                                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                                </div>
                                                <div>
                                                    <h4 class="text-base font-bold text-gray-900 group-hover:text-indigo-600 transition-colors line-clamp-1">{{ participant.activityId.title }}</h4>
                                                    <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-500">
                                                        <span class="flex items-center">
                                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                                            {{ participant.activityId.date ? participant.activityId.date|date('d/m/Y') : 'Chưa xác định' }} {{ participant.activityId.time ? participant.activityId.time|date('H:i') : '' }}
                                                        </span>
                                                        <span class="flex items-center">
                                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                                            {{ participant.activityId.location|length > 20 ? participant.activityId.location|slice(0, 20) ~ '...' : participant.activityId.location }}
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="flex flex-col items-end gap-2 ml-4 flex-shrink-0">
                                                {% if participant.activityId.status == 'planned' %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">Sắp diễn ra</span>
                                                {% elseif participant.activityId.status == 'ongoing' %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Đang diễn ra</span>
                                                {% elseif participant.activityId.status == 'completed' %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">Đã kết thúc</span>
                                                {% else %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-800">Đã hủy</span>
                                                {% endif %}
                                                
                                                {% if participant.activityId.status == 'planned' %}
                                                    <button type="button" class="text-xs font-medium text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-lg transition-colors"
                                                            onclick="event.stopPropagation(); cancelParticipation('{{ participant.activityId.id }}', '{{ csrf_token('leave' ~ participant.activityId.id) }}')">
                                                        Hủy tham gia
                                                    </button>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <div class="flex flex-col items-center justify-center h-64 text-gray-500">
                                <div class="w-16 h-16 rounded-full bg-gray-50 flex items-center justify-center mb-4">
                                    <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                </div>
                                <p class="font-medium text-gray-900">Chưa tham gia hoạt động nào</p>
                                <p class="text-sm mt-1">Danh sách hoạt động của bạn sẽ hiển thị tại đây.</p>
                                <a href="{{ path('app_activities_index') }}" class="mt-4 text-indigo-600 hover:text-indigo-800 text-sm font-medium">Khám phá hoạt động &rarr;</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function cancelParticipation(activityId, csrfToken) {
            if (confirm('Bạn có chắc chắn muốn hủy tham gia hoạt động này?')) {
                const formData = new FormData();
                formData.append('_token', csrfToken);

                fetch(`/activity_participant/leave/${activityId}`, {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    if (response.redirected) {
                        window.location.href = response.url;
                    } else {
                        return response.text().then(text => {
                            throw new Error('Có lỗi xảy ra khi hủy tham gia.');
                        });
                    }
                })
                .catch(error => {
                    alert('Lỗi: ' + error.message);
                });
            }
        }
    </script>
{% endblock %}