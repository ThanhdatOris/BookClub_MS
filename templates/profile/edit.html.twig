{% extends 'base.html.twig' %}

{% block title %}Chỉnh sửa thông tin - {{ user.name }}{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Chỉnh sửa hồ sơ</h1>
            <p class="mt-2 text-sm text-gray-500">Cập nhật thông tin cá nhân của thành viên <span class="font-semibold text-indigo-600">{{ user.name }}</span>.</p>
        </div>
        <a href="{{ path('profile', {'studentId': user.studentId}) }}" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-xl shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
            <svg class="w-5 h-5 mr-2 -ml-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Quay lại
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-100 bg-gray-50 flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-800">Thông tin chi tiết</h3>
        </div>
        
        <div class="p-6 sm:p-8">
            {{ form_start(form, {'attr': {'class': 'space-y-6', 'id': 'profileEditForm'}}) }}
                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
                    <div class="sm:col-span-2">
                        {{ form_label(form.name, 'Họ và tên', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                        {{ form_widget(form.name, {'attr': {'class': 'block w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 sm:text-sm transition-colors'}}) }}
                        <div class="mt-1 text-sm text-red-600">{{ form_errors(form.name) }}</div>
                    </div>

                    <div class="sm:col-span-1">
                        {{ form_label(form.email, 'Địa chỉ Email', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'block w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 sm:text-sm transition-colors'}}) }}
                        <div class="mt-1 text-sm text-red-600">{{ form_errors(form.email) }}</div>
                    </div>

                    <div class="sm:col-span-1">
                        {{ form_label(form.studentId, 'Mã sinh viên', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                        {{ form_widget(form.studentId, {'attr': {'class': 'block w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 sm:text-sm transition-colors'}}) }}
                        <div class="mt-1 text-sm text-red-600">{{ form_errors(form.studentId) }}</div>
                    </div>

                    <div class="sm:col-span-1">
                        {{ form_label(form.classId, 'Lớp', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                        {{ form_widget(form.classId, {'attr': {'class': 'block w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 sm:text-sm transition-colors'}}) }}
                        <div class="mt-1 text-sm text-red-600">{{ form_errors(form.classId) }}</div>
                    </div>

                    <div class="sm:col-span-1">
                        {{ form_label(form.faculty, 'Khoa', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                        {{ form_widget(form.faculty, {'attr': {'class': 'block w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 sm:text-sm transition-colors'}}) }}
                        <div class="mt-1 text-sm text-red-600">{{ form_errors(form.faculty) }}</div>
                    </div>

                    <div class="sm:col-span-2">
                        {{ form_label(form.contactInfo, 'Thông tin liên hệ (SĐT)', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                        {{ form_widget(form.contactInfo, {'attr': {'class': 'block w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 sm:text-sm transition-colors'}}) }}
                        <div class="mt-1 text-sm text-red-600">{{ form_errors(form.contactInfo) }}</div>
                    </div>
                </div>

                <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-4 mt-8">
                    <a href="{{ path('profile', {'studentId': user.studentId}) }}" class="px-6 py-3 border border-gray-300 rounded-xl shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        Hủy
                    </a>
                    <button type="submit" class="inline-flex items-center px-6 py-3 border border-transparent text-sm font-medium rounded-xl shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Lưu thay đổi
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}