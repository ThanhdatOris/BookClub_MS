{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    {% if app.user is not null and app.user.role != 'ROLE_ADMIN' %}
        <script>window.location.href = "{{ path('app_home') }}";</script>
    {% endif %}

    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Dashboard</h1>
        <p class="mt-2 text-sm text-gray-500">Tổng quan tình hình hoạt động và tài chính của câu lạc bộ.</p>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Fund Balance -->
        <a href="{{ path('app_funds_index') }}" class="group bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Số dư quỹ</p>
                    <h5 class="text-2xl font-bold text-gray-900">{{ balance|round(0, 'floor')|format_currency('VND') }}</h5>
                </div>
                <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
            </div>
            <div class="flex items-center mt-4 pt-4 border-t border-gray-50 gap-4">
                <span class="flex items-center text-emerald-600 text-xs font-medium">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
                    {{ totalIncome|round(0, 'floor')|format_currency('VND') }}
                </span>
                <span class="flex items-center text-rose-600 text-xs font-medium">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
                    {{ totalExpense|round(0, 'floor')|format_currency('VND') }}
                </span>
            </div>
        </a>

        <!-- Members -->
        <a href="{{ path('app_users_index') }}" class="group bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Thành viên</p>
                    <h5 class="text-2xl font-bold text-gray-900">{{ totalMembers }}</h5>
                </div>
                <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </div>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-50">
                <span class="text-xs font-medium text-gray-500">Tổng số hội viên</span>
            </div>
        </a>

        <!-- Activities -->
        <a href="{{ path('app_activities_index') }}" class="group bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Hoạt động mới</p>
                    <h5 class="text-2xl font-bold text-emerald-600">+{{ newActivities }}</h5>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                </div>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-50">
                <span class="text-xs font-medium text-gray-500">Tổng: {{ totalActivities }} hoạt động</span>
            </div>
        </a>

        <!-- Participations -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col justify-between">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Lượt tham gia</p>
                    <h5 class="text-2xl font-bold text-gray-900">{{ participationCount }}</h5>
                </div>
                <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path></svg>
                </div>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-50">
                <span class="text-xs font-medium text-gray-500">Lượt điểm danh thành công</span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        <!-- Fund Chart -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-lg font-bold text-gray-800">Biến động quỹ</h3>
                <select id="timeRange" class="block pl-3 pr-10 py-2 text-sm border-gray-200 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-xl bg-gray-50">
                    <option value="7">7 ngày gần nhất</option>
                    <option value="30">30 ngày gần nhất</option>
                    <option value="90">3 tháng gần nhất</option>
                    <option value="180">6 tháng gần nhất</option>
                    <option value="365">1 năm gần nhất</option>
                </select>
            </div>
            <div class="flex-1 w-full relative" style="min-height: 300px;">
                <canvas id="fundChart"></canvas>
            </div>
        </div>

        <!-- Recent Activities Carousel (Scroll Snap) -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 flex flex-col overflow-hidden relative">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center z-10">
                <h3 class="text-lg font-bold text-gray-800">Hoạt động nổi bật</h3>
            </div>
            
            {% if recentActivities|length > 0 %}
                <div class="relative flex-1 overflow-hidden group">
                    <!-- Carousel Container -->
                    <div id="activity-carousel" class="flex transition-transform duration-500 ease-out h-full w-full">
                        {% for activity in recentActivities %}
                            <div class="min-w-full relative h-full">
                                <img src="{{ asset('uploads/activities/' ~ activity.image) }}" class="w-full h-full object-cover" alt="{{ activity.title }}">
                                <div class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-gray-900/40 to-transparent"></div>
                                <div class="absolute bottom-0 left-0 right-0 p-6">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-500/80 text-white mb-2 backdrop-blur-sm">Mới nhất</span>
                                    <h4 class="text-xl font-bold text-white mb-2 line-clamp-2"><a href="{{ path('app_activities_show', {'id': activity.id}) }}" class="hover:underline">{{ activity.title }}</a></h4>
                                    <p class="text-sm text-gray-200 line-clamp-2">{{ activity.description }}</p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    
                    <!-- Controls -->
                    <button id="prev-slide" class="absolute left-3 top-1/2 -translate-y-1/2 w-8 h-8 flex items-center justify-center rounded-full bg-white/20 hover:bg-white/40 text-white backdrop-blur-sm transition opacity-0 group-hover:opacity-100 focus:outline-none">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    <button id="next-slide" class="absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 flex items-center justify-center rounded-full bg-white/20 hover:bg-white/40 text-white backdrop-blur-sm transition opacity-0 group-hover:opacity-100 focus:outline-none">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                    
                    <!-- Indicators -->
                    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2">
                        {% for activity in recentActivities %}
                            <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 transition-colors {{ loop.first ? 'bg-white' : '' }}" data-index="{{ loop.index0 }}"></button>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="flex-1 flex flex-col items-center justify-center p-8 text-center text-gray-500 bg-gray-50">
                    <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <p class="font-medium">Chưa có hoạt động nào</p>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Pending Proposals -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
            <h3 class="text-lg font-bold text-gray-800">Đề xuất đang chờ xử lý</h3>
            <a href="{{ path('app_proposals_index') }}" class="text-sm font-medium text-indigo-600 hover:text-indigo-800">Xem tất cả &rarr;</a>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-white">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Loại đề xuất</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Người gửi</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ngày tạo</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Hành động</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100">
                    {% for proposal in pendingProposals %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if proposal.type == 'edit_profile' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
                                        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                        Chỉnh sửa thông tin
                                    </span>
                                {% elseif proposal.type == 'general' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        Đề xuất chung
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200">
                                        {{ proposal.type }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">{{ proposal.userId.name }}</div>
                                <div class="text-xs text-gray-500">{{ proposal.userId.studentId }}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {{ proposal.createdAt|date('d/m/Y H:i') }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a href="{{ path('app_proposals_show', {'id': proposal.id}) }}" class="text-indigo-600 hover:text-indigo-900 bg-indigo-50 px-3 py-1 rounded-lg">Xem chi tiết</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="px-6 py-10 text-center">
                                <div class="flex flex-col items-center justify-center text-gray-500">
                                    <svg class="w-10 h-10 text-gray-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    <p class="text-sm font-medium">Tuyệt vời! Không có đề xuất nào đang chờ xử lý.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- CAROUSEL LOGIC ---
        const carousel = document.getElementById('activity-carousel');
        if (carousel) {
            const dots = document.querySelectorAll('.carousel-dot');
            const prevBtn = document.getElementById('prev-slide');
            const nextBtn = document.getElementById('next-slide');
            const totalSlides = dots.length;
            let currentSlide = 0;
            let intervalId;

            const goToSlide = (index) => {
                if (index < 0) index = totalSlides - 1;
                if (index >= totalSlides) index = 0;
                currentSlide = index;
                carousel.style.transform = `translateX(-${currentSlide * 100}%)`;
                
                dots.forEach((dot, i) => {
                    dot.classList.toggle('bg-white', i === currentSlide);
                    dot.classList.toggle('bg-white/50', i !== currentSlide);
                });
            };

            const nextSlide = () => goToSlide(currentSlide + 1);
            const prevSlide = () => goToSlide(currentSlide - 1);

            if (nextBtn && prevBtn) {
                nextBtn.addEventListener('click', () => { nextSlide(); resetInterval(); });
                prevBtn.addEventListener('click', () => { prevSlide(); resetInterval(); });
            }

            dots.forEach(dot => {
                dot.addEventListener('click', (e) => {
                    goToSlide(parseInt(e.target.dataset.index));
                    resetInterval();
                });
            });

            const startInterval = () => { intervalId = setInterval(nextSlide, 5000); };
            const resetInterval = () => { clearInterval(intervalId); startInterval(); };
            
            if(totalSlides > 1) startInterval();
        }

        // --- CHART LOGIC ---
        const fundChart = document.getElementById('fundChart');
        if (!fundChart) return;
        const ctx = fundChart.getContext('2d');
        
        const formatCurrency = (amount) => {
            amount = Number(amount);
            if (amount >= 1000000) return (Math.round(amount / 100000) / 10) + ' tr';
            if (amount >= 1000) return (Math.round(amount / 100) / 10) + ' k';
            return amount.toLocaleString('vi-VN');
        };

        const chart = new Chart(ctx, {
            type: 'bar',
            data: { labels: [], datasets: [
                { label: 'Thu', data: [], backgroundColor: 'rgba(52, 211, 153, 0.8)', borderColor: '#10b981', borderWidth: 0, borderRadius: 4 },
                { label: 'Chi', data: [], backgroundColor: 'rgba(248, 113, 113, 0.8)', borderColor: '#ef4444', borderWidth: 0, borderRadius: 4 }
            ]},
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { intersect: false, mode: 'index' },
                plugins: {
                    legend: { position: 'top', labels: { usePointStyle: true, pointStyle: 'circle', boxWidth: 8, font: { family: "'Inter', sans-serif" } } },
                    tooltip: {
                        backgroundColor: 'rgba(17, 24, 39, 0.9)',
                        titleFont: { family: "'Inter', sans-serif", size: 13 },
                        bodyFont: { family: "'Inter', sans-serif", size: 12 },
                        padding: 12,
                        cornerRadius: 8,
                        callbacks: {
                            label: (context) => `${context.dataset.label}: ${Number(context.raw).toLocaleString('vi-VN')} đ`
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0, 0, 0, 0.04)', drawBorder: false },
                        ticks: { callback: value => formatCurrency(value), font: { family: "'Inter', sans-serif" } },
                        border: { display: false }
                    },
                    x: {
                        grid: { display: false, drawBorder: false },
                        ticks: { font: { family: "'Inter', sans-serif" }, maxRotation: 0 },
                        border: { display: false }
                    }
                }
            }
        });

        const updateChartData = async (days) => {
            try {
                const endDate = new Date();
                const startDate = new Date();
                startDate.setDate(endDate.getDate() - days);

                const response = await fetch(`/api/funds/chart?startDate=${startDate.toISOString()}&endDate=${endDate.toISOString()}`);
                if (!response.ok) throw new Error(`HTTP error!`);
                const data = await response.json();
                
                if (data.labels && data.income && data.expense) {
                    // Format dates to DD/MM for better X axis fitting
                    chart.data.labels = data.labels.map(d => {
                        const date = new Date(d);
                        return `${date.getDate().toString().padStart(2, '0')}/${(date.getMonth()+1).toString().padStart(2, '0')}`;
                    });
                    chart.data.datasets[0].data = data.income;
                    chart.data.datasets[1].data = data.expense.map(v => -v);
                    chart.update();
                }
            } catch (error) { console.error('Lỗi khi cập nhật biểu đồ:', error); }
        };

        const timeRangeSelect = document.getElementById('timeRange');
        if (timeRangeSelect) {
            timeRangeSelect.addEventListener('change', function() { updateChartData(parseInt(this.value)); });
            updateChartData(parseInt(timeRangeSelect.value));
        }
    });
</script>
{% endblock %}