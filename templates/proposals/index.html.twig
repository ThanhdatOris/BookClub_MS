{% extends 'base.html.twig' %}

{% block title %}Proposals index{% endblock %}

{% block body %}
    <h1>Proposals index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Type</th>
                <th>Content</th>
                <th>Status</th>
                <th>Created_at</th>
                <th>Updated_at</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for proposal in proposals %}
            <tr>
                <td>{{ proposal.id }}</td>
                <td>{{ proposal.type }}</td>
                <td>{{ proposal.content }}</td>
                <td>{{ proposal.status }}</td>
                <td>{{ proposal.createdAt ? proposal.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ proposal.updatedAt ? proposal.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_proposals_show', {'id': proposal.id}) }}">show</a>
                    <a href="{{ path('app_proposals_edit', {'id': proposal.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_proposals_new') }}">Create new</a>
{% endblock %}
