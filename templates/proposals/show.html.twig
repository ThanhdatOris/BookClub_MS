{% extends 'base.html.twig' %}

{% block title %}Proposal Details{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card">
                <div class="card-header pb-0">
                    <h6>Proposal Details</h6>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tbody>
                            <tr>
                                <th>Id</th>
                                <td>{{ proposal.id }}</td>
                            </tr>
                            <tr>
                                <th>Type</th>
                                <td>{{ proposal.type }}</td>
                            </tr>
                            <tr>
                                <th>Content</th>
                                <td>
                                    {{ proposal.content|length > 50 ? proposal.content|slice(0, 100) ~ '...' : proposal.content }}
                                </td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td>{{ proposal.status }}</td>
                            </tr>
                            <tr>
                                <th>Created At</th>
                                <td>{{ proposal.createdAt ? proposal.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                            </tr>
                            <tr>
                                <th>Updated At</th>
                                <td>{{ proposal.updatedAt ? proposal.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a href="{{ path('app_proposals_index') }}" class="btn btn-secondary btn-sm">Back to List</a>
                    <div>
                        <a href="{{ path('app_proposals_edit', {'id': proposal.id}) }}" class="btn btn-primary btn-sm">Edit</a>
                        {{ include('proposals/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}