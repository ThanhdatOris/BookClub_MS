{% extends 'base.html.twig' %}

{% block title %}Quản lý quỹ{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Quản lý quỹ</h1>
                <p class="mt-2 text-sm text-gray-500">Quản lý thu chi, ngân sách và giao dịch của câu lạc bộ.</p>
            </div>
            {% if is_granted('ROLE_TREASURER') %}
                <div class="flex gap-3">
                    <a href="{{ path('app_funds_export') }}" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-xl shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        <svg class="w-5 h-5 mr-2 -ml-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Xuất Excel
                    </a>
                    <button type="button" class="inline-flex items-center px-4 py-2 bg-indigo-600 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors" onclick="showAddForm()">
                        <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                        Thêm giao dịch
                    </button>
                </div>
            {% endif %}
        </div>

        <!-- Statistics Section -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            {% set stats = [
                {'title': 'Tổng số dư', 'count': balance|round(0, 'floor')|format_currency('VND'), 'color': 'indigo', 'icon': 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z'},
                {'title': 'Tổng thu', 'count': totalIncome|round(0, 'floor')|format_currency('VND'), 'color': 'emerald', 'icon': 'M5 10l7-7m0 0l7 7m-7-7v18'},
                {'title': 'Tổng chi', 'count': totalExpense|round(0, 'floor')|format_currency('VND'), 'color': 'rose', 'icon': 'M19 14l-7 7m0 0l-7-7m7 7V3'},
                {'title': 'Giao dịch', 'count': funds.getTotalItemCount ~ ' GD', 'color': 'blue', 'icon': 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4'}
            ] %}
            
            {% for stat in stats %}
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex items-center justify-between hover:shadow-md transition-shadow">
                    <div>
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ stat.title }}</p>
                        <p class="mt-1 text-2xl font-bold text-gray-900">{{ stat.count }}</p>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-{{ stat.color }}-50 flex items-center justify-center">
                        <svg class="w-6 h-6 text-{{ stat.color }}-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ stat.icon }}"></path></svg>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Chart -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-8 flex flex-col">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-lg font-bold text-gray-800">Biến động quỹ</h3>
                <select id="timeRange" class="block pl-3 pr-10 py-2 text-sm border-gray-200 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-xl bg-gray-50">
                    <option value="7">7 ngày gần nhất</option>
                    <option value="30">30 ngày gần nhất</option>
                    <option value="90">3 tháng gần nhất</option>
                    <option value="180">6 tháng gần nhất</option>
                    <option value="365">1 năm gần nhất</option>
                </select>
            </div>
            <div class="flex-1 w-full relative" style="min-height: 350px;">
                <canvas id="fundChart"></canvas>
            </div>
        </div>

        <!-- Filters & Search -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 mb-8">
            <form action="{{ path('app_funds_index') }}" method="GET" class="flex flex-col sm:flex-row gap-4" id="searchForm">
                <div class="flex-1 relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <input type="text" name="search" value="{{ search }}" class="block w-full pl-10 pr-3 py-2 border border-gray-200 rounded-xl leading-5 bg-gray-50 placeholder-gray-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors" placeholder="Tìm kiếm mô tả giao dịch...">
                </div>
                <button type="submit" class="inline-flex justify-center items-center px-4 py-2 border border-gray-300 rounded-xl shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                    Tìm kiếm
                </button>
            </form>
        </div>

        <!-- Dynamic Content Panel -->
        <div id="dynamicContent" class="mb-8 scroll-mt-6 hidden">
            <!-- Populated via JS -->
        </div>

        <!-- Funds List Table -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ngày</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mô tả</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Loại</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Số tiền</th>
                            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Người tạo</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-100">
                        {% for fund in funds %}
                            <tr class="hover:bg-gray-50 cursor-pointer transition-colors" onclick="showFundDetails('{{ fund.id }}')">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    {{ fund.date|date('d/m/Y') }}
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-700">
                                    {{ fund.description|length > 40 ? fund.description|slice(0, 40) ~ '...' : fund.description }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% if fund.transactionType == 'income' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">Thu</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-800">Chi</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold {{ fund.transactionType == 'income' ? 'text-emerald-600' : 'text-rose-600' }}">
                                    {{ fund.transactionType == 'income' ? '+' : '-' }}{{ fund.amount|number_format(0, ',', '.') }} đ
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-center">
                                    {{ fund.createdBy.name }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center">
                                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 text-gray-400 mb-4">
                                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    </div>
                                    <h3 class="text-sm font-medium text-gray-900">Không tìm thấy giao dịch</h3>
                                    <p class="mt-1 text-sm text-gray-500">Không có giao dịch nào phù hợp với điều kiện tìm kiếm.</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            {% if funds.getTotalItemCount > 0 %}
                {{ knp_pagination_render(funds) }}
            {% endif %}
        </div>
    </div>

    <!-- Hidden Form Templates -->
    <div id="form-templates" class="hidden">
        <!-- Add Fund Form -->
        <div id="template-add-fund">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transform transition-all duration-300">
                <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50">
                    <h3 class="text-lg font-bold text-gray-800">Thêm giao dịch mới</h3>
                    <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none" onclick="document.getElementById('dynamicContent').classList.add('hidden')">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                <div class="p-6">
                    <div id="addFundError" class="hidden mb-4 p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200" role="alert"></div>
                    {{ form_start(addFundForm, {'attr': {'id': 'addFundForm', 'class': 'space-y-6', 'onsubmit': 'submitFundForm(event, "addFundForm", "' ~ path('app_funds_new') ~ '")'}}) }}
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                {{ form_label(addFundForm.transaction_type, 'Loại giao dịch', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(addFundForm.transaction_type, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                            </div>
                            <div>
                                {{ form_label(addFundForm.date, 'Ngày giao dịch', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(addFundForm.date, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                            </div>
                            <div class="md:col-span-2">
                                {{ form_label(addFundForm.amount, 'Số tiền (VNĐ)', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <span class="text-gray-500 sm:text-sm">đ</span>
                                    </div>
                                    {{ form_widget(addFundForm.amount, {'attr': {'class': 'block w-full pl-8 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors', 'min': '0', 'step': '1000'}}) }}
                                </div>
                            </div>
                            <div class="md:col-span-2">
                                {{ form_label(addFundForm.description, 'Mô tả chi tiết', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                {{ form_widget(addFundForm.description, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors', 'rows': 3}}) }}
                            </div>
                        </div>
                        <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
                            <button type="button" class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition-colors" onclick="document.getElementById('dynamicContent').classList.add('hidden')">Hủy</button>
                            <button type="submit" class="px-4 py-2 bg-indigo-600 border border-transparent rounded-xl text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition-colors flex items-center">
                                <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white hidden" id="addFundForm-spinner" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                Lưu giao dịch
                            </button>
                        </div>
                    {{ form_end(addFundForm) }}
                </div>
            </div>
        </div>

        <!-- Edit Fund Forms -->
        {% for fund in funds %}
            <div id="template-edit-fund-{{ fund.id }}">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transform transition-all duration-300">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50">
                        <h3 class="text-lg font-bold text-gray-800">Sửa giao dịch #{{ fund.id }}</h3>
                        <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none" onclick="showFundDetails('{{ fund.id }}')">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    <div class="p-6">
                        <div id="editFundError{{ fund.id }}" class="hidden mb-4 p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200" role="alert"></div>
                        {{ form_start(editFundForms[fund.id], {'attr': {'id': 'editFundForm' ~ fund.id, 'class': 'space-y-6', 'onsubmit': 'submitFundForm(event, "editFundForm' ~ fund.id ~ '", "' ~ path('app_funds_edit', {'id': fund.id}) ~ '")'}}) }}
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    {{ form_label(editFundForms[fund.id].transaction_type, 'Loại giao dịch', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(editFundForms[fund.id].transaction_type, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                                <div>
                                    {{ form_label(editFundForms[fund.id].date, 'Ngày giao dịch', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(editFundForms[fund.id].date, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
                                </div>
                                <div class="md:col-span-2">
                                    {{ form_label(editFundForms[fund.id].amount, 'Số tiền (VNĐ)', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                            <span class="text-gray-500 sm:text-sm">đ</span>
                                        </div>
                                        {{ form_widget(editFundForms[fund.id].amount, {'attr': {'class': 'block w-full pl-8 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors', 'min': '0', 'step': '1000'}}) }}
                                    </div>
                                </div>
                                <div class="md:col-span-2">
                                    {{ form_label(editFundForms[fund.id].description, 'Mô tả chi tiết', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                                    {{ form_widget(editFundForms[fund.id].description, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors', 'rows': 3}}) }}
                                </div>
                            </div>
                            <div class="pt-4 border-t border-gray-100 flex justify-between gap-3">
                                <button type="button" class="px-4 py-2 bg-rose-50 border border-transparent rounded-xl text-sm font-medium text-rose-700 hover:bg-rose-100 focus:outline-none transition-colors" onclick="confirmDeleteFund('${fund.id}')">Xóa giao dịch</button>
                                <div class="flex gap-3">
                                    <button type="button" class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition-colors" onclick="showFundDetails('{{ fund.id }}')">Quay lại</button>
                                    <button type="submit" class="px-4 py-2 bg-indigo-600 border border-transparent rounded-xl text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition-colors flex items-center">
                                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white hidden" id="editFundForm{{ fund.id }}-spinner" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                        Lưu thay đổi
                                    </button>
                                </div>
                            </div>
                        {{ form_end(editFundForms[fund.id]) }}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- Script Data Store & Functions -->
    <script>
        const isTreasurer = {{ is_granted('ROLE_TREASURER') ? 'true' : 'false' }};
        const fundsStore = {
            {% for fund in funds %}
                '{{ fund.id }}': {
                    id: '{{ fund.id }}',
                    date: '{{ fund.date|date('d/m/Y') }}',
                    description: '{{ fund.description|e('js')|nl2br }}',
                    transactionType: '{{ fund.transactionType }}',
                    amount: '{{ fund.amount|number_format(0, ',', '.') }} VNĐ',
                    createdBy: '{{ fund.createdBy.name|e('js') }}',
                    createdAt: '{{ fund.createdAt|date('d/m/Y H:i') }}',
                    updatedAt: '{{ fund.updatedAt|date('d/m/Y H:i') }}',
                    deleteToken: '{{ csrf_token('delete' ~ fund.id) }}'
                }{% if not loop.last %},{% endif %}
            {% endfor %}
        };

        function showFundDetails(id) {
            const fund = fundsStore[id];
            if (!fund) return;

            const panel = document.getElementById('dynamicContent');
            panel.classList.remove('hidden');

            const typeBadge = fund.transactionType === 'income' 
                ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-emerald-100 text-emerald-800"><svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>Thu</span>'
                : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-rose-100 text-rose-800"><svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>Chi</span>';

            const adminButtons = isTreasurer ? `
                <div class="mt-6 flex flex-wrap gap-3 pt-6 border-t border-gray-100">
                    <button class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition-colors" onclick="showEditForm('${fund.id}')">Chỉnh sửa</button>
                    <button class="px-4 py-2 bg-rose-50 border border-transparent rounded-xl text-sm font-medium text-rose-700 hover:bg-rose-100 focus:outline-none transition-colors" onclick="confirmDeleteFund('${fund.id}')">Xóa giao dịch</button>
                </div>
            ` : '';

            panel.innerHTML = `
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transform transition-all duration-300">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50">
                        <h3 class="text-lg font-bold text-gray-800">Chi tiết giao dịch #${fund.id}</h3>
                        <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none" onclick="document.getElementById('dynamicContent').classList.add('hidden')">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div>
                                <div class="flex items-center gap-3 mb-6">
                                    <h4 class="text-3xl font-bold ${fund.transactionType === 'income' ? 'text-emerald-600' : 'text-rose-600'}">${fund.transactionType === 'income' ? '+' : '-'}${fund.amount}</h4>
                                    ${typeBadge}
                                </div>
                                <div class="space-y-4">
                                    <div class="flex items-center text-sm">
                                        <span class="w-32 text-gray-500">Ngày giao dịch:</span>
                                        <span class="font-medium text-gray-900">${fund.date}</span>
                                    </div>
                                    <div class="flex items-center text-sm">
                                        <span class="w-32 text-gray-500">Người tạo:</span>
                                        <span class="font-medium text-gray-900">${fund.createdBy}</span>
                                    </div>
                                    <div class="flex items-center text-sm">
                                        <span class="w-32 text-gray-500">Ngày tạo:</span>
                                        <span class="font-medium text-gray-900">${fund.createdAt}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
                                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Mô tả</p>
                                <p class="text-sm text-gray-700 leading-relaxed">${fund.description}</p>
                            </div>
                        </div>
                        ${adminButtons}
                    </div>
                </div>
            `;
            window.scrollTo({ top: panel.offsetTop - 20, behavior: 'smooth' });
        }

        function showAddForm() {
            const template = document.getElementById('template-add-fund');
            if (template) {
                const panel = document.getElementById('dynamicContent');
                panel.innerHTML = template.innerHTML;
                panel.classList.remove('hidden');
                window.scrollTo({ top: panel.offsetTop - 20, behavior: 'smooth' });
            }
        }

        function showEditForm(id) {
            const template = document.getElementById('template-edit-fund-' + id);
            if (template) {
                const panel = document.getElementById('dynamicContent');
                panel.innerHTML = template.innerHTML.replace("confirmDeleteFund('${fund.id}')", `confirmDeleteFund('${id}')`);
                panel.classList.remove('hidden');
                window.scrollTo({ top: panel.offsetTop - 20, behavior: 'smooth' });
            }
        }

        function submitFundForm(e, formId, url) {
            e.preventDefault();
            const form = document.getElementById(formId);
            const spinner = document.getElementById(formId + '-spinner');
            const errorDiv = document.getElementById(formId.replace('Form', 'Error'));
            
            spinner.classList.remove('hidden');
            if (errorDiv) errorDiv.classList.add('hidden');
            
            fetch(url, {
                method: 'POST',
                body: new FormData(form)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location.href = data.redirect;
                } else {
                    if (errorDiv) {
                        errorDiv.textContent = data.error || 'Có lỗi xảy ra';
                        errorDiv.classList.remove('hidden');
                    } else {
                        alert(data.error || 'Có lỗi xảy ra');
                    }
                }
            })
            .catch(err => alert('Lỗi kết nối'))
            .finally(() => spinner.classList.add('hidden'));
        }

        function confirmDeleteFund(id) {
            const fund = fundsStore[id];
            if (!fund) return;
            
            if (confirm(`Bạn có chắc chắn muốn xóa giao dịch #${id} không?\n\nSố tiền: ${fund.amount}\nMô tả: ${fund.description}`)) {
                const formData = new FormData();
                formData.append('_token', fund.deleteToken);
                
                fetch(`/funds/${id}`, {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        window.location.reload();
                    } else {
                        alert(data.error || 'Lỗi khi xóa giao dịch');
                    }
                })
                .catch(err => alert('Lỗi kết nối'));
            }
        }
    </script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fundChart = document.getElementById('fundChart');
            if (!fundChart) return;
            const ctx = fundChart.getContext('2d');
            
            const formatCurrency = (amount) => {
                amount = Number(amount);
                if (amount >= 1000000) return (Math.round(amount / 100000) / 10) + ' tr';
                if (amount >= 1000) return (Math.round(amount / 100) / 10) + ' k';
                return amount.toLocaleString('vi-VN');
            };

            const chart = new Chart(ctx, {
                type: 'bar',
                data: { labels: [], datasets: [
                    { label: 'Thu', data: [], backgroundColor: 'rgba(52, 211, 153, 0.8)', borderColor: '#10b981', borderWidth: 0, borderRadius: 4 },
                    { label: 'Chi', data: [], backgroundColor: 'rgba(248, 113, 113, 0.8)', borderColor: '#ef4444', borderWidth: 0, borderRadius: 4 }
                ]},
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: {
                        legend: { position: 'top', labels: { usePointStyle: true, pointStyle: 'circle', boxWidth: 8, font: { family: "'Inter', sans-serif" } } },
                        tooltip: {
                            backgroundColor: 'rgba(17, 24, 39, 0.9)',
                            titleFont: { family: "'Inter', sans-serif", size: 13 },
                            bodyFont: { family: "'Inter', sans-serif", size: 12 },
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: (context) => `${context.dataset.label}: ${Number(context.raw).toLocaleString('vi-VN')} đ`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0, 0, 0, 0.04)', drawBorder: false },
                            ticks: { callback: value => formatCurrency(value), font: { family: "'Inter', sans-serif" } },
                            border: { display: false }
                        },
                        x: {
                            grid: { display: false, drawBorder: false },
                            ticks: { font: { family: "'Inter', sans-serif" }, maxRotation: 0 },
                            border: { display: false }
                        }
                    }
                }
            });

            const updateChartData = async (days) => {
                try {
                    const endDate = new Date();
                    const startDate = new Date();
                    startDate.setDate(endDate.getDate() - days);

                    const response = await fetch(`/api/funds/chart?startDate=${startDate.toISOString()}&endDate=${endDate.toISOString()}`);
                    if (!response.ok) throw new Error(`HTTP error!`);
                    const data = await response.json();
                    
                    if (data.labels && data.income && data.expense) {
                        chart.data.labels = data.labels.map(d => {
                            const date = new Date(d);
                            return `${date.getDate().toString().padStart(2, '0')}/${(date.getMonth()+1).toString().padStart(2, '0')}`;
                        });
                        chart.data.datasets[0].data = data.income;
                        chart.data.datasets[1].data = data.expense.map(v => -v);
                        chart.update();
                    }
                } catch (error) { console.error('Lỗi khi cập nhật biểu đồ:', error); }
            };

            const timeRangeSelect = document.getElementById('timeRange');
            if (timeRangeSelect) {
                timeRangeSelect.addEventListener('change', function() { updateChartData(parseInt(this.value)); });
                updateChartData(parseInt(timeRangeSelect.value));
            }
        });
    </script>
{% endblock %}