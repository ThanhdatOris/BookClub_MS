{% extends 'base.html.twig' %}

{% block title %}Quản lý quỹ{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="card shadow mb-4">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="text-uppercase text-secondary font-weight-bold mb-0">Quản lý quỹ</h6>
                    <div class="d-flex align-items-center">
                        <div class="d-flex align-items-center me-2 mb-0">
                            <input type="text" id="fundsSearchInput" class="form-control me-2" placeholder="Tìm kiếm giao dịch..." style="max-width: 300px;">
                            <button type="button" id="fundsClearSearchBtn" class="btn btn-sm btn-secondary mb-0 ms-2 d-none">Xóa bộ lọc</button>
                        </div>
                        {% if is_granted('ROLE_ADMIN') %}
                            <button type="button" class="btn btn-sm btn-success mb-0" data-bs-toggle="modal" data-bs-target="#addFundModal">
                                <i class="fas fa-plus me-1"></i> Thêm giao dịch
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# Bảng hiển thị dữ liệu #}
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Danh sách giao dịch</h6>
            </div>
            <div class="card-body px-0 pt-0 pb-2">
                <div class="table-responsive p-0 px-3" style="max-height: 1080px; overflow-y: auto;">
                    <table class="table table-hover align-items-center mb-0">
                        <thead>
                            <tr>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">ID</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Ngày</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Mô tả</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Loại giao dịch</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Số tiền</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="fundsTableBody">
                            <!-- Populated via JavaScript -->
                        </tbody>
                    </table>
                </div>
                <div class="navigation mt-4 d-flex justify-content-center">
                    <nav>
                        <ul class="pagination" id="fundsPagination"></ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    {# Modal thêm giao dịch #}
    <div class="modal fade" id="addFundModal" tabindex="-1" role="dialog" aria-labelledby="addFundModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addFundModalLabel">Thêm giao dịch mới</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                {{ form_start(addFundForm) }}
                <div class="modal-body">
                    {{ form_widget(addFundForm) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu</button>
                </div>
                {{ form_end(addFundForm) }}
            </div>
        </div>
    </div>

    {# Modal sửa giao dịch #}
    {% for fund in funds %}
        <div class="modal fade" id="editFundModal{{ fund.id }}" tabindex="-1" role="dialog" aria-labelledby="editFundModalLabel{{ fund.id }}" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editFundModalLabel{{ fund.id }}">Sửa giao dịch #{{ fund.id }}</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    {{ form_start(editFundForms[fund.id]) }}
                    <div class="modal-body">
                        {{ form_widget(editFundForms[fund.id]) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    </div>
                    {{ form_end(editFundForms[fund.id]) }}
                </div>
            </div>
        </div>
    {% endfor %}

    <!-- Include table-layout.js -->
    <script src="{{ asset('js/table-layout.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const fundsTable = new TableLayout({
                data: [
                    {% for fund in funds %}
                        {
                            id: '{{ fund.id }}',
                            date: '{{ fund.date ? fund.date|date('Y-m-d') : '' }}',
                            description: '{{ fund.description|e('js') }}',
                            transactionType: '{{ fund.transactionType }}',
                            amount: '{{ fund.amount|number_format(0, ',', '.') }} VNĐ',
                            actions: `
                                <button type="button" class="btn btn-sm btn-info" data-toggle="modal" data-target="#editFundModal{{ fund.id }}" onclick="event.stopPropagation();">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <form method="post" action="{{ path('app_funds_delete', {'id': fund.id}) }}" style="display: inline-block" onsubmit="return confirm('Bạn có chắc chắn muốn xóa?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ fund.id) }}">
                                    <button class="btn btn-sm btn-danger" onclick="event.stopPropagation();"><i class="fas fa-trash"></i></button>
                                </form>
                            `
                        },
                    {% endfor %}
                ],
                tableBodyId: 'fundsTableBody',
                searchInputId: 'fundsSearchInput',
                clearSearchBtnId: 'fundsClearSearchBtn',
                paginationId: 'fundsPagination',
                columns: [
                    { field: 'id' },
                    { field: 'date', type: 'date' },
                    {
                        field: 'description',
                        formatter: (value) => `<p class="text-sm mb-0">${value.length > 50 ? value.slice(0, 50) + '...' : value}</p>`
                    },
                    {
                        field: 'transactionType',
                        formatter: (value) => `
                            <span class="badge bg-${value === 'income' ? 'success' : 'danger'}">${value === 'income' ? 'Thu' : 'Chi'}</span>
                        `
                    },
                    {
                        field: 'amount',
                        formatter: (value) => `<p class="text-sm font-weight-bold mb-0">${value}</p>`
                    },
                    {
                        field: 'actions',
                        className: 'text-center'
                    }
                ]
            });
        });
    </script>
{% endblock %}