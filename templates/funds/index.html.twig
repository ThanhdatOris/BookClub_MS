{% extends 'base.html.twig' %}

{% block title %}Funds index{% endblock %}

{% block body %}
    <h1>Funds index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Transaction_type</th>
                <th>Amount</th>
                <th>Date</th>
                <th>Description</th>
                <th>Created_at</th>
                <th>Updated_at</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for fund in funds %}
            <tr>
                <td>{{ fund.id }}</td>
                <td>{{ fund.transactionType }}</td>
                <td>{{ fund.amount }}</td>
                <td>{{ fund.date ? fund.date|date('Y-m-d') : '' }}</td>
                <td>{{ fund.description }}</td>
                <td>{{ fund.createdAt ? fund.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ fund.updatedAt ? fund.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_funds_show', {'id': fund.id}) }}">show</a>
                    {# Chỉ hiển thị nút "edit" nếu user có quyền chỉnh sửa #}
                    {% if is_granted('EDIT', fund) %}
                        <a href="{{ path('app_funds_edit', {'id': fund.id}) }}">edit</a>
                    {% endif %}
                    {# Chỉ hiển thị nút "delete" nếu user có quyền xóa #}
                    {% if is_granted('DELETE', fund) %}
                        <form method="post" action="{{ path('app_funds_delete', {'id': fund.id}) }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this fund?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ fund.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm">delete</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_funds_new') }}">Create new</a>
{% endblock %}