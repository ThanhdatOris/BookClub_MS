{% extends 'base.html.twig' %}

{% block title %}Quản lý quỹ{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <!-- Thông báo flash -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <!-- Header và Danh sách giao dịch trong một card -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header pb-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="text-uppercase text-secondary font-weight-bold mb-0">Quản lý quỹ</h6>
                            <div class="d-flex align-items-center">
                                <div class="d-flex align-items-center mb-0">
                                    <input type="text" id="searchInput" class="form-control me-2" placeholder="Tìm kiếm giao dịch..." style="max-width: 300px;">
                                    <button type="button" id="clearSearchBtn" class="btn btn-secondary mb-0 me-2 d-none">Hủy</button>
                                </div>
                                {% if is_granted('ROLE_TREASURER') %}
                                    <button type="button" class="btn btn-success mb-0" data-bs-toggle="modal" data-bs-target="#addFundModal">
                                        <i class="fas fa-plus me-1"></i> Thêm giao dịch
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="card-body px-0 pt-0 pb-2">
                        <div class="table-responsive p-0 px-3" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-hover align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">
                                            <a href="#" class="sort-link" data-sort="date">Ngày</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">
                                            <a href="#" class="sort-link" data-sort="transactionType">Loại giao dịch</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">
                                            <a href="#" class="sort-link" data-sort="amount">Số tiền</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Mô tả</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">
                                            <a href="#" class="sort-link" data-sort="createdBy">Người tạo</a>
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody id="fundsTableBody">
                                    {% for fund in funds %}
                                        <tr data-url="{{ path('app_funds_show', {'id': fund.id, 'referer': app.request.uri}) }}" style="cursor: pointer;">
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0 text-center">{{ fund.date|date('Y-m-d') }}</p>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column justify-content-center text-center">
                                                    <h6 class="mb-0 text-sm text-{{ fund.transactionType == 'income' ? 'success' : 'danger' }}">
                                                        {{ fund.transactionType == 'income' ? 'Thu' : 'Chi' }}
                                                    </h6>
                                                </div>
                                            </td>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0 text-center">{{ fund.amount|format_currency('VND') }}</p>
                                            </td>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">{{ fund.description|length > 50 ? fund.description|slice(0, 50) ~ '...' : fund.description }}</p>
                                            </td>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0 text-center">{{ fund.createdBy.name }}</p>
                                            </td>
                                            <td class="text-center">
                                                {% if is_granted('ROLE_TREASURER') %}
                                                    <button type="button" class="btn btn-sm btn-primary mb-0" data-bs-toggle="modal" data-bs-target="#editFundModal{{ fund.id }}" onclick="event.stopPropagation();">Sửa</button>
                                                    <button type="button" class="btn btn-sm btn-danger mb-0 delete-btn" data-id="{{ fund.id }}" data-csrf-token="{{ csrf_token('delete' ~ fund.id) }}" onclick="event.stopPropagation();">Xóa</button>
                                                {% elseif is_granted('ROLE_ADMIN') %}
                                                    <a href="{{ path('app_funds_show', {'id': fund.id}) }}" class="btn btn-sm btn-info mb-0" onclick="event.stopPropagation();">Xem chi tiết</a>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center">Không có giao dịch nào.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <!-- Phân trang client-side -->
                        <div class="navigation mt-4 d-flex justify-content-center">
                            <nav>
                                <ul class="pagination" id="pagination">
                                    <!-- Phân trang sẽ được tạo bằng JavaScript -->
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal: Thêm giao dịch -->
        <div class="modal fade" id="addFundModal" tabindex="-1" aria-labelledby="addFundModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addFundModalLabel">Thêm giao dịch</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="addFundError" class="alert alert-danger d-none"></div>
                        {{ form_start(addFundForm, {'attr': {'id': 'addFundForm'}}) }}
                            <div class="mb-3">
                                {{ form_label(addFundForm.transaction_type) }}
                                {{ form_widget(addFundForm.transaction_type, {'attr': {'class': 'form-select'}}) }}
                                <div class="text-danger">{{ form_errors(addFundForm.transaction_type) }}</div>
                            </div>
                            <div class="mb-3">
                                {{ form_label(addFundForm.amount) }}
                                {{ form_widget(addFundForm.amount, {'attr': {'class': 'form-control'}}) }}
                                <div class="text-danger">{{ form_errors(addFundForm.amount) }}</div>
                            </div>
                            <div class="mb-3">
                                {{ form_label(addFundForm.date) }}
                                {{ form_widget(addFundForm.date, {'attr': {'class': 'form-control'}}) }}
                                <div class="text-danger">{{ form_errors(addFundForm.date) }}</div>
                            </div>
                            <div class="mb-3">
                                {{ form_label(addFundForm.description) }}
                                {{ form_widget(addFundForm.description, {'attr': {'class': 'form-control'}}) }}
                                <div class="text-danger">{{ form_errors(addFundForm.description) }}</div>
                            </div>
                            {{ form_row(addFundForm._token) }}
                            <button type="submit" class="btn btn-primary" id="addFundSubmitBtn">
                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true" id="addFundSpinner"></span>
                                Lưu
                            </button>
                        {{ form_end(addFundForm) }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal: Sửa giao dịch -->
        {% for fund in funds %}
            <div class="modal fade" id="editFundModal{{ fund.id }}" tabindex="-1" aria-labelledby="editFundModalLabel{{ fund.id }}" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="editFundModalLabel{{ fund.id }}">Sửa giao dịch</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div id="editFundError{{ fund.id }}" class="alert alert-danger d-none"></div>
                            {{ form_start(editFundForms[fund.id], {'attr': {'id': 'editFundForm' ~ fund.id}}) }}
                                <div class="mb-3">
                                    {{ form_label(editFundForms[fund.id].transaction_type) }}
                                    {{ form_widget(editFundForms[fund.id].transaction_type, {'attr': {'class': 'form-select'}}) }}
                                    <div class="text-danger">{{ form_errors(editFundForms[fund.id].transaction_type) }}</div>
                                </div>
                                <div class="mb-3">
                                    {{ form_label(editFundForms[fund.id].amount) }}
                                    {{ form_widget(editFundForms[fund.id].amount, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger">{{ form_errors(editFundForms[fund.id].amount) }}</div>
                                </div>
                                <div class="mb-3">
                                    {{ form_label(editFundForms[fund.id].date) }}
                                    {{ form_widget(editFundForms[fund.id].date, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger">{{ form_errors(editFundForms[fund.id].date) }}</div>
                                </div>
                                <div class="mb-3">
                                    {{ form_label(editFundForms[fund.id].description) }}
                                    {{ form_widget(editFundForms[fund.id].description, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger">{{ form_errors(editFundForms[fund.id].description) }}</div>
                                </div>
                                {{ form_row(editFundForms[fund.id]._token) }}
                                <button type="submit" class="btn btn-primary" id="editFundSubmitBtn{{ fund.id }}">
                                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true" id="editFundSpinner{{ fund.id }}"></span>
                                    Cập nhật
                                </button>
                            {{ form_end(editFundForms[fund.id]) }}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

        <!-- Include table-layout.js -->
        <script src="{{ asset('js/table-layout.js') }}"></script>

        <!-- JavaScript để khởi tạo TableLayout -->
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Khởi tạo TableLayout
                const tableLayout = new TableLayout({
                    data: [
                        {% for fund in funds %}
                            {
                                date: '{{ fund.date|date('Y-m-d') }}',
                                transactionType: '{{ fund.transactionType }}',
                                amount: {{ fund.amount }},
                                description: '{{ fund.description|e('js') }}',
                                createdBy: '{{ fund.createdBy.name|e('js') }}',
                                detailUrl: '{{ path('app_funds_show', {'id': fund.id, 'referer': app.request.uri}) }}',
                                actions: `
                                    {% if is_granted('ROLE_TREASURER') %}
                                        <button type="button" class="btn btn-sm btn-primary mb-0" data-bs-toggle="modal" data-bs-target="#editFundModal{{ fund.id }}" onclick="event.stopPropagation();">Sửa</button>
                                        <button type="button" class="btn btn-sm btn-danger mb-0 delete-btn" data-id="{{ fund.id }}" data-csrf-token="{{ csrf_token('delete' ~ fund.id) }}" onclick="event.stopPropagation();">Xóa</button>
                                    {% elseif is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('app_funds_show', {'id': fund.id}) }}" class="btn btn-sm btn-info mb-0" onclick="event.stopPropagation();">Xem chi tiết</a>
                                    {% endif %}
                                `
                            },
                        {% endfor %}
                    ],
                    tableBodyId: 'fundsTableBody',
                    columns: [
                        { field: 'date', class: 'text-center', type: 'date' },
                        {
                            field: 'transactionType',
                            class: 'text-center',
                            formatter: (value) => `
                                <div class="d-flex flex-column justify-content-center text-center">
                                    <h6 class="mb-0 text-sm text-${value === 'income' ? 'success' : 'danger'}">
                                        ${value === 'income' ? 'Thu' : 'Chi'}
                                    </h6>
                                </div>
                            `
                        },
                        { field: 'amount', class: 'text-center', type: 'currency' },
                        {
                            field: 'description',
                            formatter: (value) => value.length > 50 ? value.slice(0, 50) + '...' : value
                        },
                        { field: 'createdBy', class: 'text-center' }
                    ],
                    onRowClick: (row) => {
                        const detailUrl = row.getAttribute('data-url');
                        if (detailUrl) window.location.href = detailUrl;
                    },
                    onDelete: (button) => {
                        if (!confirm('Bạn có chắc chắn muốn xóa giao dịch này?')) return;
                        const id = button.getAttribute('data-id');
                        const csrfToken = button.getAttribute('data-csrf-token');
                        fetch(`/funds/${id}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: `_token=${csrfToken}`
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) window.location.href = data.redirect;
                            else alert(data.error);
                        })
                        .catch(error => alert('Có lỗi xảy ra: ' + error.message));
                    },
                    scrollPositionKey: 'funds_table_scroll_position'
                });

                // Xử lý form thêm giao dịch
                const addFundForm = document.getElementById('addFundForm');
                if (addFundForm) {
                    const addFundSubmitBtn = document.getElementById('addFundSubmitBtn');
                    const addFundSpinner = document.getElementById('addFundSpinner');
                    const addFundError = document.getElementById('addFundError');

                    addFundForm.addEventListener('submit', function (e) {
                        e.preventDefault();
                        const formData = new FormData(this);
                        tableLayout.showLoading(addFundSubmitBtn, addFundSpinner);
                        tableLayout.hideError(addFundError);

                        fetch(this.action, {
                            method: 'POST',
                            body: formData
                        })
                        .then(response => response.json())
                        .then(data => {
                            tableLayout.hideLoading(addFundSubmitBtn, addFundSpinner);
                            if (data.success) window.location.href = data.redirect;
                            else tableLayout.showError(addFundError, data.error);
                        })
                        .catch(error => {
                            tableLayout.hideLoading(addFundSubmitBtn, addFundSpinner);
                            tableLayout.showError(addFundError, 'Có lỗi xảy ra: ' + error.message);
                        });
                    });
                }

                // Xử lý form sửa giao dịch
                document.querySelectorAll('[id^="editFundForm"]').forEach(form => {
                    const formId = form.id;
                    const submitBtn = document.getElementById('editFundSubmitBtn' + formId.replace('editFundForm', ''));
                    const spinner = document.getElementById('editFundSpinner' + formId.replace('editFundForm', ''));
                    const errorDiv = document.getElementById('editFundError' + formId.replace('editFundForm', ''));

                    form.addEventListener('submit', function (e) {
                        e.preventDefault();
                        const formData = new FormData(this);
                        tableLayout.showLoading(submitBtn, spinner);
                        tableLayout.hideError(errorDiv);

                        fetch(this.action, {
                            method: 'POST',
                            body: formData
                        })
                        .then(response => response.json())
                        .then(data => {
                            tableLayout.hideLoading(submitBtn, spinner);
                            if (data.success) window.location.href = data.redirect;
                            else tableLayout.showError(errorDiv, data.error);
                        })
                        .catch(error => {
                            tableLayout.hideLoading(submitBtn, spinner);
                            tableLayout.showError(errorDiv, 'Có lỗi xảy ra: ' + error.message);
                        });
                    });
                });
            });
        </script>
    </div>
{% endblock %}