{% extends 'base.html.twig' %}

{% block title %}Quản lý thành viên{% endblock %}

{% block body %}
    {# Form fields #}
    {% set form_fields = {
        'student_id': form_row(form.student_id),
        'name': form_row(form.name),
        'email': form_row(form.email),
        'gender': form_row(form.gender),
        'faculty': form_row(form.faculty),
        'class_id': form_row(form.class_id),
        'role': form_row(form.role),
        'contact_info': form_row(form.contact_info)
    } %}

    <script>
        const CSRF_TOKEN = '{{ csrf_token('toggle-status') }}';

        function handleToggleStatus(userId, currentStatus) {
            const newStatus = currentStatus === 'active' ? 'inactive' : 'active';
            const actionText = newStatus === 'inactive' ? 'vô hiệu hóa' : 'kích hoạt';
            
            if (confirm(`Bạn có chắc chắn muốn ${actionText} thành viên này?`)) {
                const formData = new FormData();
                formData.append('_token', CSRF_TOKEN);
                
                fetch(`/members/${userId}/toggle-status`, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        window.location.reload();
                    } else {
                        alert(data.error || `Có lỗi xảy ra khi ${actionText} thành viên`);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert(`Có lỗi xảy ra khi ${actionText} thành viên.`);
                });
            }
        }

        function showUserDetail(user) {
            const roleBadge = user.role === 'ROLE_ADMIN' 
                ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">Quản lý</span>'
                : user.role === 'ROLE_TREASURER'
                ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Thủ quỹ</span>'
                : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Thành viên</span>';

            const genderText = user.gender === 'male' ? 'Nam' : user.gender === 'female' ? 'Nữ' : 'Khác';
            const isActive = user.status === 'active';

            dynamicContent.innerHTML = `
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-8 transition-all duration-300 transform">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50/50">
                        <h3 class="text-lg font-bold text-gray-800">Chi tiết thành viên</h3>
                        <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none transition-colors" onclick="hideForm()">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    <div class="p-6">
                        <div class="flex flex-col md:flex-row gap-8">
                            <!-- Avatar Column -->
                            <div class="flex flex-col items-center md:w-1/3">
                                <div class="w-32 h-32 rounded-full overflow-hidden shadow-md mb-4 border-4 border-white">
                                    <img src="{{ asset('img/default.png') }}" class="w-full h-full object-cover" alt="Avatar">
                                </div>
                                <h4 class="text-xl font-bold text-gray-900 text-center">${user.name}</h4>
                                <p class="text-gray-500 text-sm mb-3">${user.studentId}</p>
                                ${roleBadge}
                            </div>

                            <!-- Info Column -->
                            <div class="md:w-2/3 space-y-6">
                                <!-- Personal Info Card -->
                                <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
                                    <h5 class="text-sm font-semibold text-gray-800 uppercase tracking-wider mb-4 flex items-center">
                                        <svg class="w-4 h-4 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                        Thông tin cá nhân
                                    </h5>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                        <div>
                                            <span class="block text-xs font-medium text-gray-500 uppercase">Email</span>
                                            <span class="block mt-1 text-sm text-gray-900 break-all">${user.email}</span>
                                        </div>
                                        <div>
                                            <span class="block text-xs font-medium text-gray-500 uppercase">Khoa</span>
                                            <span class="block mt-1 text-sm text-gray-900">${user.faculty || '<span class="text-red-500 italic">Chưa cập nhật</span>'}</span>
                                        </div>
                                        <div>
                                            <span class="block text-xs font-medium text-gray-500 uppercase">Lớp</span>
                                            <span class="block mt-1 text-sm text-gray-900">${user.classId || '<span class="text-red-500 italic">Chưa cập nhật</span>'}</span>
                                        </div>
                                        <div>
                                            <span class="block text-xs font-medium text-gray-500 uppercase">Giới tính</span>
                                            <span class="block mt-1 text-sm text-gray-900">${genderText}</span>
                                        </div>
                                        <div class="sm:col-span-2">
                                            <span class="block text-xs font-medium text-gray-500 uppercase">Liên hệ</span>
                                            <span class="block mt-1 text-sm text-gray-900">${user.contactInfo || '<span class="text-red-500 italic">Chưa cập nhật</span>'}</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Activity Stats Card -->
                                <div class="bg-indigo-50/50 rounded-xl p-5 border border-indigo-100">
                                    <h5 class="text-sm font-semibold text-gray-800 uppercase tracking-wider mb-4 flex items-center">
                                        <svg class="w-4 h-4 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                                        Thống kê hoạt động
                                    </h5>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div class="bg-white rounded-lg p-3 shadow-sm border border-gray-100 flex items-center">
                                            <div class="p-2 bg-blue-100 text-blue-600 rounded-lg mr-3">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                            </div>
                                            <div>
                                                <p class="text-xs text-gray-500 uppercase">Tổng tham gia</p>
                                                <p class="text-lg font-bold text-gray-900">${user.total_activities}</p>
                                            </div>
                                        </div>
                                        <div class="bg-white rounded-lg p-3 shadow-sm border border-gray-100 flex items-center">
                                            <div class="p-2 bg-green-100 text-green-600 rounded-lg mr-3">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                            </div>
                                            <div>
                                                <p class="text-xs text-gray-500 uppercase">Đã điểm danh</p>
                                                <p class="text-lg font-bold text-gray-900">${user.attended_activities}</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                {% if is_granted('ROLE_ADMIN') %}
                                <div class="flex justify-end gap-3 mt-4 pt-4 border-t border-gray-100">
                                    <button type="button" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors shadow-sm" onclick="showEditUserForm(${user.id})">
                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                        Chỉnh sửa
                                    </button>
                                    <button type="button" 
                                            class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg font-medium text-white shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors ${isActive ? 'bg-red-600 hover:bg-red-700 focus:ring-red-500' : 'bg-green-600 hover:bg-green-700 focus:ring-green-500'}"
                                            onclick="handleToggleStatus(${user.id}, '${user.status}')">
                                        ${isActive 
                                            ? '<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg> Vô hiệu hóa' 
                                            : '<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Kích hoạt'}
                                    </button>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }
    </script>

    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Thành viên câu lạc bộ</h1>
            <p class="mt-2 text-sm text-gray-500">Quản lý thông tin, phân quyền và theo dõi hoạt động của tất cả thành viên.</p>
        </div>

        <!-- Statistics Section -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <!-- Total -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex items-center justify-between hover:shadow-md transition-shadow">
                <div>
                    <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Tổng số</p>
                    <p class="mt-1 text-3xl font-bold text-gray-900">{{ total_users }}</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                </div>
            </div>

            <!-- Active -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex items-center justify-between hover:shadow-md transition-shadow">
                <div>
                    <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Đang hoạt động</p>
                    <p class="mt-1 text-3xl font-bold text-green-600">{{ active_users }}</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-green-50 flex items-center justify-center">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
            </div>

            <!-- Roles -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col justify-center hover:shadow-md transition-shadow">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Quản lý</span>
                    <span class="text-sm font-bold text-purple-600">{{ admin_users }}</span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-1.5 mb-3">
                    <div class="bg-purple-500 h-1.5 rounded-full" style="width: {{ (admin_users / total_users * 100)|round }}%"></div>
                </div>
                
                <div class="flex justify-between items-center mb-2">
                    <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Thủ quỹ & Thành viên</span>
                    <span class="text-sm font-bold text-gray-700">{{ treasurer_users + member_users }}</span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-1.5">
                    <div class="bg-indigo-400 h-1.5 rounded-full" style="width: {{ ((treasurer_users + member_users) / total_users * 100)|round }}%"></div>
                </div>
            </div>
        </div>

        <!-- Dynamic Content Container -->
        <div id="dynamicContent" class="mb-8 scroll-mt-6">
            <!-- Default Empty State -->
            <div class="bg-white rounded-2xl border border-gray-200 border-dashed p-10 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-indigo-50 text-indigo-500 mb-4">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-1">Chọn một thành viên</h3>
                <p class="text-gray-500 text-sm">Click vào một dòng trong bảng bên dưới để xem thông tin chi tiết hoặc chỉnh sửa.</p>
            </div>
        </div>

        <!-- Table Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-6 border-b border-gray-100 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="relative w-full sm:w-96">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <input type="text" id="usersSearchInput" class="block w-full pl-10 pr-3 py-2 border border-gray-200 rounded-xl leading-5 bg-gray-50 placeholder-gray-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors" placeholder="Tìm kiếm theo tên, mã SV, email...">
                </div>
                
                {% if is_granted('ROLE_ADMIN') %}
                <button type="button" class="w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 bg-indigo-600 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors" onclick="showAddUserForm()">
                    <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                    Thêm thành viên
                </button>
                {% endif %}
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mã SV</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Thành viên</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Khoa</th>
                            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Vai trò</th>
                            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody" class="bg-white divide-y divide-gray-100">
                        <!-- TableLayout will fill this -->
                    </tbody>
                </table>
            </div>
            
            <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex items-center justify-center">
                <nav aria-label="Page navigation">
                    <ul class="inline-flex -space-x-px" id="usersPagination"></ul>
                </nav>
            </div>
        </div>
    </div>

    <script src="{{ asset('js/table-layout.js') }}"></script>
    <script id="users-json-data" type="application/json">
        {{ users_json|raw }}
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const usersData = JSON.parse(document.getElementById('users-json-data').textContent);
            const dynamicContent = document.getElementById('dynamicContent');
            
            const usersTable = new TableLayout({
                data: usersData,
                tableBodyId: 'usersTableBody',
                searchInputId: 'usersSearchInput',
                paginationId: 'usersPagination',
                itemsPerPage: 10,
                columns: [
                    { 
                        field: 'studentId', 
                        formatter: (value) => `<div class="px-6 py-4 whitespace-nowrap"><span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium bg-gray-100 text-gray-800">${value}</span></div>`
                    },
                    {
                        field: 'name',
                        formatter: (value, item) => `
                            <div class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0 h-10 w-10">
                                        <img class="h-10 w-10 rounded-full object-cover border border-gray-200" src="{{ asset('img/default.png') }}" alt="">
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-medium text-gray-900">${item.name}</div>
                                        <div class="text-sm text-gray-500">${item.email}</div>
                                    </div>
                                </div>
                            </div>`
                    },
                    {
                        field: 'faculty',
                        formatter: (value) => `<div class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">${value || '-'}</div>`
                    },
                    {
                        field: 'role',
                        formatter: (value) => {
                            let badge = '';
                            if (value === 'ROLE_ADMIN') badge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">Quản lý</span>';
                            else if (value === 'ROLE_TREASURER') badge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Thủ quỹ</span>';
                            else badge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Thành viên</span>';
                            return `<div class="px-6 py-4 whitespace-nowrap text-center">${badge}</div>`;
                        }
                    },
                    {
                        field: 'status',
                        formatter: (value) => {
                            const icon = value === 'active' 
                                ? `<svg class="w-5 h-5 text-green-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
                                : `<svg class="w-5 h-5 text-red-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
                            return `<div class="px-6 py-4 whitespace-nowrap text-center">${icon}</div>`;
                        }
                    }
                ],
                rowAttributes: (item) => ({
                    'data-id': item.id,
                    'class': 'hover:bg-gray-50 cursor-pointer transition-colors border-b border-gray-100 last:border-0'
                }),
                onRowClick: (row) => {
                    const userId = row.getAttribute('data-id');
                    if (userId) {
                        const user = usersData.find(u => u.id == userId);
                        if (user) {
                            showUserDetail(user);
                            window.scrollTo({ top: dynamicContent.offsetTop - 20, behavior: 'smooth' });
                        }
                    }
                }
            });

            window.showAddUserForm = function() {
                fetch('/members/new', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(data => {
                    dynamicContent.innerHTML = `
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-8 transition-all duration-300 transform">
                            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50/50">
                                <h3 class="text-lg font-bold text-gray-800">Thêm thành viên mới</h3>
                                <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none" onclick="hideForm()">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                </button>
                            </div>
                            <div class="p-6">
                                ${data.form}
                            </div>
                        </div>
                    `;
                    initAjaxForm('addUserForm');
                    window.scrollTo({ top: dynamicContent.offsetTop - 20, behavior: 'smooth' });
                });
            };

            window.showEditUserForm = function(userId) {
                fetch(`/members/${userId}/edit`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(data => {
                    dynamicContent.innerHTML = `
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-8 transition-all duration-300 transform">
                            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-gray-50/50">
                                <h3 class="text-lg font-bold text-gray-800">Chỉnh sửa thông tin</h3>
                                <button type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none" onclick="hideForm()">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                </button>
                            </div>
                            <div class="p-6">
                                ${data.form}
                            </div>
                        </div>
                    `;
                    initAjaxForm('editUserForm');
                    window.scrollTo({ top: dynamicContent.offsetTop - 20, behavior: 'smooth' });
                });
            };

            window.hideForm = function() {
                dynamicContent.innerHTML = `
                    <div class="bg-white rounded-2xl border border-gray-200 border-dashed p-10 text-center transition-all duration-300">
                        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-indigo-50 text-indigo-500 mb-4">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-1">Chọn một thành viên</h3>
                        <p class="text-gray-500 text-sm">Click vào một dòng trong bảng bên dưới để xem thông tin chi tiết hoặc chỉnh sửa.</p>
                    </div>
                `;
            };

            function initAjaxForm(formId) {
                const form = document.getElementById(formId) || dynamicContent.querySelector('form');
                if (form) {
                    form.addEventListener('submit', async function(e) {
                        e.preventDefault();
                        try {
                            const formData = new FormData(this);
                            const response = await fetch(this.action, {
                                method: 'POST',
                                body: formData,
                                headers: { 'X-Requested-With': 'XMLHttpRequest' }
                            });

                            const data = await response.json();
                            if (data.success) {
                                alert(data.message);
                                window.location.reload();
                            } else {
                                alert(data.error || 'Có lỗi xảy ra.');
                            }
                        } catch (error) {
                            console.error('Lỗi khi gửi form:', error);
                            alert('Lỗi hệ thống. Vui lòng thử lại sau.');
                        }
                    });
                }
            }
        });
    </script>
{% endblock %}