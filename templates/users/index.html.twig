{% extends 'base.html.twig' %}

{% block title %}Quản lý thành viên{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <!-- Thống kê -->
                <div class="row pb-3 ">
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                        <div class="card">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-8">
                                        <div class="numbers">
                                            <p class="text-sm mb-0 text-uppercase font-weight-bold">Tổng số</p>
                                            <h5 class="font-weight-bolder">{{ total_users }}</h5>
                                        </div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div class="icon icon-shape bg-gradient-info shadow text-center border-radius-md">
                                            <i class="fas fa-users text-lg opacity-10" aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                        <div class="card">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-8">
                                        <div class="numbers">
                                            <p class="text-sm mb-0 text-uppercase font-weight-bold">Hoạt động</p>
                                            <h5 class="font-weight-bolder">{{ active_users }}</h5>
                                        </div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div class="icon icon-shape bg-gradient-success shadow text-center border-radius-md">
                                            <i class="fas fa-user-check text-lg opacity-10" aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                        <div class="card">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-8">
                                        <div class="numbers">
                                            <p class="text-sm mb-0 text-uppercase font-weight-bold">Ngưng hoạt động</p>
                                            <h5 class="font-weight-bolder">{{ inactive_users }}</h5>
                                        </div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div class="icon icon-shape bg-gradient-danger shadow text-center border-radius-md">
                                            <i class="fas fa-user-times text-lg opacity-10" aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row pb-3">
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                        <div class="card">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-8">
                                        <div class="numbers">
                                            <p class="text-sm mb-0 text-uppercase font-weight-bold">Quản lý</p>
                                            <h5 class="font-weight-bolder">{{ admin_users }}</h5>
                                        </div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
                                            <i class="fas fa-user-shield text-lg opacity-10" aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                        <div class="card">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-8">
                                        <div class="numbers">
                                            <p class="text-sm mb-0 text-uppercase font-weight-bold">Thủ quỹ</p>
                                            <h5 class="font-weight-bolder">{{ treasurer_users }}</h5>
                                        </div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div class="icon icon-shape bg-gradient-warning shadow text-center border-radius-md">
                                            <i class="fas fa-user-tie text-lg opacity-10" aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6">
                        <div class="card">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-8">
                                        <div class="numbers">
                                            <p class="text-sm mb-0 text-uppercase font-weight-bold">Thành viên</p>
                                            <h5 class="font-weight-bolder">{{ member_users }}</h5>
                                        </div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div class="icon icon-shape bg-gradient-success shadow text-center border-radius-md">
                                            <i class="fas fa-user text-lg opacity-10" aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="text-uppercase text-secondary font-weight-bold mb-0">Quản lý thành viên</h6>
                            <div class="d-flex align-items-center">
                                <div class="d-flex align-items-center me-2 mb-0">
                                    <input type="text" id="usersSearchInput" class="form-control me-2" placeholder="Tìm kiếm thành viên..." style="max-width: 300px;">
                                    <button type="button" id="usersClearSearchBtn" class="btn btn-sm btn-secondary mb-0 ms-2 d-none">Xóa bộ lọc</button>
                                </div>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_users_new') }}" class="btn btn-success mb-0">
                                        <i class="fas fa-plus me-2"></i>Thêm thành viên
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="card-body px-0 pt-0 pb-2">
                        <!-- Bảng dữ liệu -->
                        <div class="table-responsive p-0 px-3">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            {{ knp_pagination_sortable(users, 'Mã sinh viên', 'u.studentId') }}
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            {{ knp_pagination_sortable(users, 'Tên', 'u.name') }}
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            {{ knp_pagination_sortable(users, 'Khoa', 'u.faculty') }}
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            {{ knp_pagination_sortable(users, 'Vai trò', 'u.role') }}
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">
                                            {{ knp_pagination_sortable(users, 'Trạng thái', 'u.status') }}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% if users|length > 0 %}
                                    {% for user in users %}
                                        <tr data-bs-toggle="modal" data-bs-target="#userModal{{ user.id }}" style="cursor: pointer;">
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">{{ user.studentId }}</p>
                                            </td>
                                            <td>
                                                <div class="d-flex px-2 py-1">
                                                    <div>
                                                        <img src="{{ asset('img/team-3.jpg') }}" class="avatar avatar-sm me-3">
                                                    </div>
                                                    <div class="d-flex flex-column justify-content-center">
                                                        <h6 class="mb-0 text-sm">{{ user.name }}</h6>
                                                        <p class="text-xs text-secondary mb-0">{{ user.email }}</p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">{{ user.faculty }}</p>
                                            </td>
                                            <td>
                                                {% if user.role == 'ROLE_ADMIN' %}
                                                    <span class="badge badge-sm bg-gradient-primary">Quản lý</span>
                                                {% elseif user.role == 'ROLE_TREASURER' %}
                                                    <span class="badge badge-sm bg-gradient-warning">Thủ quỹ</span>
                                                {% else %}
                                                    <span class="badge badge-sm bg-gradient-success">Thành viên</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if user.status == 'active' %}
                                                    <i class="fas fa-check-circle text-success"></i>
                                                {% else %}
                                                    <i class="fas fa-times-circle text-danger"></i>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center">
                                            <p class="text-sm mb-0">Không tìm thấy thành viên nào</p>
                                        </td>
                                    </tr>
                                {% endif %}
                                </tbody>
                            </table>
                        </div>

                        <!-- Phân trang -->
                        <div class="px-3 pt-4">
                            {{ knp_pagination_render(users) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Render modal ở ngoài bảng, sau bảng #}
    {% for user in users %}
        <div class="modal fade" id="userModal{{ user.id }}" tabindex="-1" aria-labelledby="userModalLabel{{ user.id }}" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold" id="userModalLabel{{ user.id }}">Thông tin chi tiết thành viên</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-0">
                        <div class="row g-4 align-items-center">
                            <!-- Avatar và tên -->
                            <div class="col-md-4 text-center">
                                <img src="{{ asset('img/team-3.jpg') }}" class="rounded-circle shadow mb-3" style="width: 140px; height: 140px; object-fit: cover;">
                                <h5 class="fw-bold mb-1 mt-2">{{ user.name }}</h5>
                                <div class="text-secondary small">{{ user.studentId }}</div>
                            </div>
                            <!-- Thông tin chi tiết -->
                            <div class="col-md-8">
                                <div class="row g-3 mb-2">
                                    <div class="col-6">
                                        <div class="text-uppercase text-muted small mb-1">Email</div>
                                        <div class="fw-semibold">{{ user.email }}</div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-uppercase text-muted small mb-1">Khoa</div>
                                        <div class="fw-semibold">{{ user.faculty }}</div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-uppercase text-muted small mb-1">Vai trò</div>
                                        <span class="badge rounded-pill px-3 py-2 {% if user.role == 'ROLE_ADMIN' %}bg-primary{% elseif user.role == 'ROLE_TREASURER' %}bg-warning text-dark{% else %}bg-success{% endif %}">
                                            {% if user.role == 'ROLE_ADMIN' %}Quản lý{% elseif user.role == 'ROLE_TREASURER' %}Thủ quỹ{% else %}Thành viên{% endif %}
                                        </span>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-uppercase text-muted small mb-1">Trạng thái</div>
                                        <span class="badge rounded-pill px-3 py-2 {% if user.status == 'active' %}bg-success{% else %}bg-secondary{% endif %}">
                                            {% if user.status == 'active' %}Đang hoạt động{% else %}Ngưng hoạt động{% endif %}
                                        </span>
                                    </div>
                                </div>
                                <hr class="my-3">
                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="card shadow-sm border-0">
                                            <div class="card-body d-flex align-items-center gap-3 p-3">
                                                <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                                    <i class="fas fa-calendar text-info fs-4"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold fs-5 mb-0">{{ user_stats[user.id].total_activities }}</div>
                                                    <div class="small text-muted">Tổng hoạt động</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card shadow-sm border-0">
                                            <div class="card-body d-flex align-items-center gap-3 p-3">
                                                <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                                    <i class="fas fa-check text-success fs-4"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold fs-5 mb-0">{{ user_stats[user.id].attended_activities }}</div>
                                                    <div class="small text-muted">Đã điểm danh</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-4">
                        <div class="w-100 d-flex justify-content-end gap-2">
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_users_edit', {'id': user.id}) }}" class="btn btn-primary px-4">
                                    <i class="fas fa-edit me-2"></i>Chỉnh sửa
                                </a>
                                <form method="post" action="{{ path('app_users_toggle_status', {'id': user.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle-status' ~ user.id) }}">
                                    <button type="submit" class="btn px-4 {% if user.status == 'active' %}btn-danger{% else %}btn-success{% endif %}">
                                        <i class="fas {% if user.status == 'active' %}fa-user-times{% else %}fa-user-check{% endif %} me-2"></i>
                                        {% if user.status == 'active' %}Vô hiệu hóa{% else %}Kích hoạt{% endif %}
                                    </button>
                                </form>
                            {% endif %}
                            <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
{% endblock %}