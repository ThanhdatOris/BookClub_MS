{{ form_start(form, {
    'attr': {
        'novalidate': 'novalidate',
        'class': 'needs-validation',
        'id': id|default('')
    },
    'action': action|default(''),
    'method': 'POST'
}) }}
    <div class="card card-body border-0 shadow-sm">
        <div class="row">
            <div class="col-md-12">
                {{ form_row(form._token) }}
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    {{ form_row(form.name, {'label': 'Họ tên', 'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    {{ form_row(form.gender, {'label': 'Giới tính', 'attr': {'class': 'form-select'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    {{ form_row(form.email, {'label': 'Email', 'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    {{ form_row(form.student_id, {'label': 'Mã sinh viên', 'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    {{ form_row(form.faculty, {'label': 'Khoa', 'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    {{ form_row(form.class_id, {'label': 'Lớp', 'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    {{ form_row(form.role, {'label': 'Vai trò', 'attr': {'class': 'form-select'}}) }}
                </div>
            </div>
            {% if app.user and app.user.id == form.vars.data.id %}
                <div class="col-md-12">
                    <div class="alert alert-warning mt-2">
                        Bạn không thể tự thay đổi vai trò của mình.
                    </div>
                </div>
            {% endif %}
            <div class="col-md-12">
                <div class="form-group">
                    {{ form_row(form.contact_info, {'label': 'Thông tin liên hệ', 'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
        </div>
        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary">{{ button_label|default('Cập nhật') }}</button>
        </div>
    </div>
{{ form_end(form) }}