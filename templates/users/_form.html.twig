{{ form_start(form, {
    'attr': {
        'novalidate': 'novalidate',
        'class': 'space-y-6',
        'id': id|default('editUserForm')
    },
    'action': action|default(''),
    'method': 'POST'
}) }}
    
    {{ form_row(form._token) }}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            {{ form_label(form.name, 'Họ tên', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
        </div>
        
        <div>
            {{ form_label(form.gender, 'Giới tính', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.gender, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
        </div>

        <div>
            {{ form_label(form.email, 'Email', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
        </div>

        <div>
            {{ form_label(form.student_id, 'Mã sinh viên', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.student_id, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
        </div>

        <div>
            {{ form_label(form.faculty, 'Khoa', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.faculty, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
        </div>

        <div>
            {{ form_label(form.class_id, 'Lớp', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.class_id, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
        </div>

        <div>
            {{ form_label(form.role, 'Vai trò', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.role, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
        </div>
        
        <div>
            {{ form_label(form.contact_info, 'Thông tin liên hệ', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.contact_info, {'attr': {'class': 'block w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors'}}) }}
        </div>
    </div>

    {% if app.user and app.user.id == form.vars.data.id %}
        <div class="rounded-lg bg-yellow-50 p-4 border border-yellow-200 mt-4">
            <div class="flex items-center">
                <svg class="h-5 w-5 text-yellow-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <p class="text-sm text-yellow-700">Bạn không thể tự thay đổi vai trò của mình.</p>
            </div>
        </div>
    {% endif %}

    <div class="pt-5 mt-5 border-t border-gray-100 flex justify-end gap-3">
        <button type="button" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-xl font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors shadow-sm" onclick="hideForm()">Hủy</button>
        <button type="submit" class="inline-flex items-center px-4 py-2 bg-indigo-600 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
            {{ button_label|default('Lưu thông tin') }}
        </button>
    </div>

{{ form_end(form) }}