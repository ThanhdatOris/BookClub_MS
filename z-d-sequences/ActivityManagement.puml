@startuml
' File: ActivityManagement.puml

start

' Quy trình thêm hoạt động
:BCN đăng nhập với vai trò quản trị viên;
:BCN nhấn "Quản lý hoạt động";
:BCN nhấn "Thêm mới";

' Nhập thông tin hoạt động
repeat
    :Nhập thông tin hoạt động;
    ' note right
    '     Validate thông tin:
    '     - Tên hoạt động
    '     - Thời gian bắt đầu/kết thúc
    '     - Địa điểm
    ' end note
    
    ' Kiểm tra thông tin
    if (Thông tin hợp lệ?) then (Có)
        :Gán created_by = ID của BCN;
        :Gán created_at = thời gian hiện tại;
        :Gán updated_at = thời gian hiện tại;
        :Gán status = "planned";
        :Lưu hoạt động vào CSDL;
        :Tạo lịch nhắc nhở;
        :Gửi thông báo cho thành viên;
        :Hiển thị thông báo "Thêm hoạt động thành công";
    else (Không)
        :Hiển thị thông báo lỗi chi tiết;
    endif
repeat while (Thông tin hợp lệ)

' ' Quy trình cập nhật hoạt động
' :BCN chọn hoạt động cần cập nhật;
' :BCN chỉnh sửa thông tin;
' :Validate thông tin mới;

